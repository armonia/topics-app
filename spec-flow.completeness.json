{
  "_notes": [
    "Completeness config for spec-flow (STANDARD.md in @armonia-io/spec-flow).",
    "Today only D9 Tier A is wired: the mutation score of the modules where a bug the tests miss",
    "really costs (a land that merges the wrong branch, a card launched at the wrong account's",
    "expense, a permission granted). `spec-flow check-mutation` reads mutation.tierA and the",
    "baseline; stryker.config.mjs mutates exactly these targets. A module enters with its",
    "starting score (`spec-flow check-mutation --update-baseline`), and from there it only goes up."
  ],
  "consumer": "topics",
  "mutation": {
    "tierA": {
      "tool": "stryker",
      "on": "nightly+pr",
      "targets": [
        "server/services/landing-verdict.ts",
        "server/services/landing-files.ts",
        "server/services/dispatch-card-price.ts",
        "server/services/dispatch-card-weight.ts",
        "server/services/dispatch-topic-identity.ts",
        "server/providers/native/permissions.ts"
      ],
      "tests": [
        "server/services/landing-verdict.test.ts",
        "server/services/landing-files.test.ts",
        "server/services/dispatch-card-price.test.ts",
        "server/services/dispatch-card-weight.test.ts",
        "server/services/dispatch-topic-identity.test.ts",
        "server/providers/native/permissions.test.ts"
      ],
      "threshold": 0.9,
      "report": "reports/mutation/mutation.json",
      "baseline": "spec-flow.mutation-baseline.json",
      "coverageAnalysis": "perTest",
      "incremental": true
    }
  }
}
