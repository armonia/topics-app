{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "server.ts",
        "server/ai-bridge.mjs!",
        "server/pty-bridge.mjs!",
        "cli/topics.ts!",
        "scripts/*.ts!",
        "server/**/*.test.ts",
        "tests/**/*.{test,spec}.ts"
      ],
      "project": [
        "server/**/*.{ts,mjs}",
        "shared/**/*.ts",
        "cli/**/*.ts",
        "scripts/**/*.ts",
        "server.ts"
      ],
      "ignore": [
        "tests/e2e/**",
        "openspec/**",
        "landing/**",
        "desktop-tauri/**",
        "public/**",
        "videos/**",
        "performance/**"
      ]
    },
    "client": {
      "entry": [
        "src/main.tsx",
        "vite.config.ts",
        "vite.demo.config.ts",
        "vite.landing.config.ts",
        "src/demo/**/*.{ts,tsx}!",
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  },
  "ignoreBinaries": ["playwright", "eslint", "spec-flow"],
  "ignoreDependencies": [],
  "bun": false,
  "playwright": false
}
