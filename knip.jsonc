// Knip esce 0 con zero export/file morti. Gli unici avvisi che restano sono
// «configuration hints» e sono VOLUTI: knip chiama "ridondanti" i pattern che
// coincidono coi suoi default (`server.ts`, `src/main.tsx`, i config di Vite),
// ma qui gli entrypoint stanno scritti perché questo file è anche la mappa di
// cosa entra nel grafo — toglierli affiderebbe la copertura a un default che
// può cambiare sotto. L'ultimo, su `.css`, dice solo che knip non segue gli
// import dei fogli di stile: servirebbe un plugin, e non ci sono CSS orfani da
// cercare.
{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      // `!` = "this IS an entrypoint, even though nothing imports it".
      // Everything marked so is reached from OUTSIDE the import graph:
      // a shell command, a launchd job, or Claude Code's hook settings.
      "entry": [
        "server.ts",
        "server/ai-bridge.mjs!", // spawned as a detached daemon
        "server/pty-bridge.mjs!", // idem
        "cli/topics.ts!", // the `topics` CLI binary
        // Entrypoints are invoked as `bun <path>`, never imported, so knip
        // can't reach them — but the `!` must be NARROW. A blanket
        // `scripts/**/*.ts!` amnestied the whole folder: any dead script there
        // was invisible by construction, which is how watch-board-tasks.ts sat
        // orphaned for months. List the three families that really are
        // entrypoints and let everything else in `scripts/` be checked.
        "scripts/check-*.ts!",            // wired to package.json / CI
        "scripts/typecheck-*.ts!",
        "scripts/e2e-shards-summary.ts!", // invoked by scripts/e2e-shards.sh:88
        "scripts/gen-migrations-manifest.ts!", // run by hand to regenerate migrations-embedded.ts
        "scripts/watch-board-tasks.ts!",  // CLI tool for the Monitor loop, run by hand
        "scripts/disk-report.ts!",        // `bun run report:disk`
        "scripts/token-live.ts!",         // diagnostica a mano: `bun scripts/token-live.ts [filtro] [--watch]`
        "scripts/*.test.ts!",             // run by `bun test ./scripts` in test:unit
        // Everything else under scripts/ stays a PROJECT file only (see the
        // `project` list below). Listing the folder here — with or without `!` —
        // would re-grant the amnesty this narrowing exists to remove: any dead
        // script would be invisible by construction. The cost of the explicit
        // list is one line when a script is added; the benefit is that adding
        // it forces the question "who calls this?" to have an answer.
        "server/db/seed.ts!", // one-shot JSON→SQLite migration, run by hand
        // `*.fixture.ts` = processo finto lanciato da un test con `bun <path>`
        // (es. l'agente ACP di `acp-provider.test.ts`): nessuno lo IMPORTA, il
        // riferimento è una stringa di path.
        "server/**/*.fixture.ts!",
        "server/**/*.test.ts",
        "shared/**/*.test.ts", // girati da `test:unit`, non importati da nessuno
        "tests/**/*.{test,spec}.ts"
      ],
      "project": [
        "server/**/*.{ts,mjs}",
        "shared/**/*.ts",
        "cli/**/*.ts",
        "scripts/**/*.ts",
        "server.ts"
      ],
      // Niente `ignore`. C'era `tests/e2e/**`, ed era il motivo per cui questo
      // check dava falsi positivi a raffica: un export usato SOLO da uno spec
      // e2e risultava morto, e chi leggeva il report doveva verificarli a mano
      // uno per uno. Knip li risolve benissimo — l'esclusione costava precisione
      // e non comprava niente. Il resto (public/, landing/, desktop-tauri/,
      // openspec/, videos/, performance/, .reference/) cade già fuori da
      // `project` e non va elencato.
    },
    "client": {
      "entry": [
        "src/main.tsx",
        "vite.config.ts",
        "vite.demo.config.ts",
        "vite.landing.config.ts",
        "src/demo/**/*.{ts,tsx}!",
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        // Deliberately kept unwired — see the note in GlobalSettings.tsx.
        "src/hooks/usePushNotifications.ts"
      ]
    }
  },
  // `pkill`, `du` e `tsc` sono invocati dagli script di package.json ma non sono
  // dipendenze: i primi due sono coreutils POSIX, il terzo è il tsc pinnato
  // sotto client/node_modules. `playwright`, `eslint` e `spec-flow` stavano qui
  // e non servivano più — knip li risolve da solo.
  "ignoreBinaries": ["pkill", "du", "tsc"],
  // Caricato per PATH dal filesystem (tests/e2e/chat-layout-audit.spec.ts:34
  // fa resolve su node_modules/axe-core/axe.min.js e lo inietta nella pagina),
  // quindi non compare in nessun import e knip non può vederlo.
  "ignoreDependencies": ["axe-core"],
  // Components declared AND consumed inside their own file (a local card
  // registry, the sub-components of one screen) are exported only so the file
  // reads as a set of named units. Without this knip flags ~150 of them and
  // the report becomes noise nobody reads.
  "ignoreExportsUsedInFile": true,
  // `@knipignore` nel JSDoc = "questo export HA un consumatore che knip non può
  // vedere". Oggi il caso è uno solo e preciso: un test che carica il modulo con
  // `await import()` — perché deve prima installare una finestra finta — e ne
  // destruttura i seam. L'import dinamico non è un vezzo, è l'ordine di
  // esecuzione, quindi il riferimento non è statico. Il tag va sul singolo
  // export, col motivo scritto sopra: un ignore per NOME in questo file
  // sopravviverebbe alla morte del test che lo giustifica.
  "tags": ["-knipignore"],
  "bun": false,
  "playwright": false
}
