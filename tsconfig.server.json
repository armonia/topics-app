{
  // Server typecheck config. The server runs on Bun with NO build-time tsc step,
  // so type errors accumulated unchecked (~440 `any`, drifting contracts). This
  // gives the editor correct Bun globals (kills the spurious "Cannot find name
  // 'Bun'/'bun:sqlite'" diagnostics) and powers a CI ratchet — see
  // scripts/typecheck-server.ts and AUDIT-2026-06-19.md priority #3.
  //
  // Pinned to the client's tsc (5.9.3); --ignoreDeprecations "5.0" is required
  // for the same reason as client/tsconfig.app.json.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["server", "server.ts", "shared"],
  "exclude": ["**/*.test.ts"]
}
