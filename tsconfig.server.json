{
  // Server typecheck config. The server runs on Bun with NO build-time tsc step,
  // so type errors used to accumulate unchecked. This gives the editor correct
  // Bun globals (kills the spurious "Cannot find name 'Bun'/'bun:sqlite'"
  // diagnostics) and powers a CI ratchet — see scripts/typecheck-server.ts.
  //
  // FULL `strict` since 2026-07-29. The old comment here claimed noImplicitAny
  // "would flood on the ~440 untyped spots"; when actually measured, the whole
  // backlog was FOUR errors in two files — burnt down by months of refactors
  // with nobody updating the note. Don't reintroduce a scary number without
  // running the compiler first.
  //
  // Pinned to the client's tsc (5.9.3); --ignoreDeprecations "5.0" is required
  // for the same reason as client/tsconfig.app.json.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    // `strictNullChecks` is implied by `strict`, but spelling it out is not
    // redundant here: it is the one flag whose removal would silently break
    // discriminated-union narrowing (`if (!r.ok) … r.error`) across the result
    // types, and the previous config kept it on alone for exactly that reason.
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // `allowJs` senza `checkJs`: tsc LEGGE i .mjs per risolverne i tipi, ma non
    // li controlla. Serve a `scripts/changelog-lib.test.ts`, che importa
    // `./changelog-lib.mjs` — senza questo l'import è un TS7016 («nessun file
    // di dichiarazione») e sarebbe l'unico ostacolo a includere `scripts`.
    // Attivare anche `checkJs` è un'altra decisione: metterebbe sotto esame
    // ai-bridge.mjs e pty-bridge.mjs, che sono demoni, non moduli.
    "allowJs": true,
    "checkJs": false
  },
  // The tests are typechecked too. Excluding them left 108 files / ~21k lines of
  // server+shared tests outside every gate — and they cost exactly one error to
  // bring in (a `binPath` the provider config never had).
  //
  // `scripts` e `cli` sono entrati il 05/08/2026, e sono lo stesso aneddoto una
  // seconda volta: erano 18 file TypeScript — inclusi i check che fanno da
  // cancello in CI — più il sorgente del binario `topics`, e nessuno di loro era
  // typecheckato da niente. Un refuso lì dentro si scopriva a runtime, in CI, nel
  // punto in cui il check avrebbe dovuto proteggere qualcos'altro. Misurato prima
  // di allargare, come dice il commento sopra: costo zero errori.
  "include": ["server", "server.ts", "shared", "scripts", "cli"]
}
