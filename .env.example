# Topics Server Configuration
# Copy this file to .env and fill in your values
#
# WARNING: Topics has no built-in authentication.
# Do not expose it to the public internet without additional security.

# Server settings
PORT=3333

# REQUIRED: OpenClaw Gateway token
# The server will not start without this
GATEWAY_TOKEN=your-gateway-token-here

# OpenClaw Gateway URL
GATEWAY_URL=http://127.0.0.1:18789

# OpenClaw directory (defaults to ~/.openclaw)
# OPENCLAW_DIR=/path/to/.openclaw

# Sessions directory (defaults to $OPENCLAW_DIR/agents/main/sessions)
# SESSIONS_DIR=/path/to/sessions

# ElevenLabs TTS (optional - required for text-to-speech)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Remote Access (optional)
# TAILSCALE_URL=https://your-machine.tailnet-name.ts.net
# CLOUDFLARE_TUNNEL_URL=https://your-tunnel.trycloudflare.com
