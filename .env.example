# Topics Server Configuration
# Copy this file to .env and fill in your values
#
# WARNING: Topics has no built-in authentication.
# Do not expose it to the public internet without additional security.

# Server settings
PORT=3333

# AI Provider (openclaw or claude)
AI_PROVIDER=openclaw

# REQUIRED for openclaw: OpenClaw Gateway token
# The server will not start without this
GATEWAY_TOKEN=your-gateway-token-here

# OpenClaw Gateway URL
GATEWAY_URL=http://127.0.0.1:18789

# For Claude provider (standalone mode, no OpenClaw needed)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# App data directory (defaults to ~/.openclaw for backwards compat)
# APP_DATA_DIR=/path/to/data
# OPENCLAW_DIR=/path/to/.openclaw  # legacy alias for APP_DATA_DIR

# Sessions directory (defaults to $OPENCLAW_DIR/agents/main/sessions)
# SESSIONS_DIR=/path/to/sessions

# ElevenLabs (optional) - text-to-speech AND Scribe v2 speech-to-text
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ==== Dictation / speech-to-text ====
# With no config at all, /api/stt tries, in order, whichever it can:
#   ElevenLabs scribe_v2 -> OpenAI gpt-transcribe -> Deepgram nova-3
#   -> Groq whisper-large-v3-turbo -> local whisper.cpp (ffmpeg + whisper-cli)
# A provider is "available" when its key is set; the first that answers wins.
# STT_PROVIDER=auto           # or: openai | elevenlabs | deepgram | groq | local | "openai,local"
# STT_LANGUAGE=auto           # ISO-639-1 (it, en, ...) — auto-detect when unset
# STT_MODEL_OPENAI=gpt-transcribe
# DEEPGRAM_API_KEY=
# GROQ_API_KEY=
# Local whisper.cpp only: model auto-discovered under ~/whisper-models etc.
# WHISPER_MODEL_PATH=/path/to/ggml-large-v3-turbo.bin

# Remote Access (optional)
# TAILSCALE_URL=https://your-machine.tailnet-name.ts.net
# CLOUDFLARE_TUNNEL_URL=https://your-tunnel.trycloudflare.com

# ==== Phase 30 BROWSER-CHAT-03 -- Moondream vision fallback (optional) ====
# The browser_point tool uses this for canvas/captcha grounding.
# Get key from: https://moondream.ai (Cloud Account -> API keys)
# If unset, browser_point returns a structured error -- the other 5 browser_*
# tools (open/observe/act/extract/screenshot) work without it.
# MOONDREAM_API_KEY=md_xxx...

# Per-context budget for browser_point calls (default 5). Counter is reset
# when the BrowserContext is destroyed (e.g. topic browser closed).
# MOONDREAM_MAX_CALLS_PER_TASK=5
