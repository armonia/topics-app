# Stato della skill `jarvis-goal`: l'obiettivo e la BARRA del lavoro in corso,
# scritti da `jarvis-goal set` e riletti da `jarvis-goal check`. È per-sessione
# e per-macchina — chi lavora qui in quel momento — quindi committarlo
# significherebbe imporre a chiunque la barra di qualcun altro. Vicino a
# graphify-out/ perché è la stessa categoria: uscita di un attrezzo, non del
# progetto.
/.jarvis/

# ai-bridge broker store (ephemeral NDJSON session buffers)
ai-bridge/

# bench/results/ai-latency-latest.json e' un puntatore «ultimo run» rigenerato
# a ogni passata con E2E_BENCH=1: non porta informazione che i file datati non
# abbiano gia', e tracciarlo sporcava il checkout dopo ogni run E2E normale.
# I file datati (ai-latency-darwin-YYYY-MM-DD.json) restano tracciati: sono la
# memoria storica delle misure, confrontabili nel tempo.
bench/results/ai-latency-latest.json

# L'identificativo di QUESTA installazione. Lo genera il server al primo avvio e
# vive in STATE_DIR — che sotto launchd è la radice del repo, ed è il motivo per
# cui compare qui. Ci si lega la LICENZA (un gettone coniato per un'altra
# installazione viene rifiutato) e gli eventi di Stripe; nel relay non entra e
# in nessun link compare. Non è un segreto, ma è per-macchina: tracciarlo
# vorrebbe dire che due installazioni rivendicano la stessa licenza.
installation-id

# La preimmagine del nome con cui questa macchina si aggancia al relay. Stesso
# posto e stessa ragione del file qui sopra, ma con una differenza che conta:
# questo È un segreto. Chi lo legge può presentarsi al relay come questa
# macchina e prendersi il traffico dei suoi ospiti — è esattamente la cosa da
# cui `shared/relay-identita.ts` esiste per difendere. Il server lo scrive con
# modo 600; tracciarlo lo pubblicherebbe.
relay-secret

# Uscita del banco WebRTC (`bun scripts/webrtc-probe.ts`): filmati del viewer e
# referti. Si rigenerano lanciandolo, e pesano megabyte: fuori dalla storia.
artifacts/

# I termini personali che il cancello `no-personal-data-tracked` cerca. Non
# tracciato: committarlo pubblicherebbe proprio cio che deve restare fuori.
.personal-terms

# radici usa-e-getta dei test che hanno bisogno di un percorso NON nascosto
