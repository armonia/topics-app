#!/usr/bin/env sh
# Optional git hook: a worktree made by a bare `git worktree add` registers
# itself with Topics, whoever made it (a person, Codex, jcode, a script).
#
# Install it as `post-checkout` in a `core.hooksPath` folder (or call it from
# the post-checkout you already have). `git worktree add` runs post-checkout in
# the NEW worktree with the previous HEAD all zeros; a clone does too, but its
# `.git` is a folder and it is skipped. Every other checkout is ignored.
#
# It never blocks git: whatever happens it exits 0, and without Topics running
# it does nothing (the cleanup finds the folder on its own within a day).
# `TOPICS_WORKTREE_REGISTER=skip` is set by the worktree hook itself, which
# registers its own worktrees with their real creator.
prev="${1:-}"
case "$prev" in
  *[!0]*|'') exit 0 ;;
esac
[ "${TOPICS_WORKTREE_REGISTER:-}" = skip ] && exit 0
top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$top/.git" ] || exit 0
here="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
lib="${TOPICS_WORKTREE_LIB:-}"
[ -n "$lib" ] && [ -r "$lib" ] || lib="${TOPICS_HOME:-$HOME/.topics}/claude-hooks/worktree-hook.sh"
[ -r "$lib" ] || lib="$here/../claude-hooks/worktree-hook.sh"
[ -r "$lib" ] || exit 0
sh "$lib" register "$top" >/dev/null 2>&1 || true
exit 0
