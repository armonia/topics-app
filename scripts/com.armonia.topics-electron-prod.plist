<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE — do NOT put real secrets here (this file is committed to git).

  1. Copy this file to ~/Library/LaunchAgents/com.armonia.topics-electron-prod.plist
  2. Replace every /path/to/topics-app with the absolute path to your clone
  3. Fill in GATEWAY_TOKEN (and the optional ELEVENLABS_API_KEY) from your .env
  4. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.armonia.topics-electron-prod.plist

  The values you fill in live only in your local (installed) copy, never in the repo.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.armonia.topics-electron-prod</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/topics-app/scripts/start-electron-prod.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/topics-app</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>3333</string>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>GATEWAY_TOKEN</key>
        <string>REPLACE_WITH_YOUR_GATEWAY_TOKEN</string>
        <key>GATEWAY_URL</key>
        <string>http://127.0.0.1:18789</string>
        <key>ELEVENLABS_API_KEY</key>
        <string>REPLACE_WITH_YOUR_ELEVENLABS_API_KEY_OR_LEAVE_BLANK</string>
        <key>PATH</key>
        <string>/path/to/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/topics-electron-prod.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/topics-electron-prod.err</string>
</dict>
</plist>
