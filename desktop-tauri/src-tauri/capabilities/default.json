{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Topics desktop shell — core + native plugin permissions. UI is served locally (tauri://localhost); no remote-origin IPC is granted.",
  "windows": ["main", "detach-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "opener:allow-open-url",
    "process:default",
    "process:allow-restart",
    "os:default",
    "dialog:allow-open",
    "updater:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/topics-server", "sidecar": true, "args": true }
      ]
    }
  ]
}
