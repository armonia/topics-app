# Generated by Cargo
# will have compiled files and executables
/target/
/gen/schemas

# Bundled server sidecar — compiled per-target by CI (bun build --compile) and
# named binaries/topics-server-<triple>. A build artifact, never committed.
/binaries/

# Bundled PTY runtime — staged per-target by scripts/stage-pty-runtime.sh
# (official Node dist + node-pty prebuilds). A build artifact, never committed.
/pty-runtime/
