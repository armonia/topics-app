{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Topics",
  "version": "2.2.240",
  "identifier": "io.armonia.topics.tauri",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Topics",
        "width": 1400,
        "height": 900,
        "center": true,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 12
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMUIwQTM1MzNDOTJCQjAKUldTd0s4a3pOUW9iV29YUkVMLzdsT01xZFMvSXpRdjJGRDFVTkxvSDhDRUhQT0lDdDJZcURwaEUK",
      "endpoints": [
        "https://github.com/armonia/topics-app/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx",
          "txt"
        ],
        "name": "Testo e documentazione",
        "description": "Documento di testo",
        "role": "Editor",
        "mimeType": "text/markdown;text/plain"
      },
      {
        "ext": [
          "ts",
          "tsx",
          "js",
          "jsx",
          "mjs",
          "cjs",
          "rs",
          "py",
          "go",
          "rb",
          "java",
          "kt",
          "swift",
          "c",
          "h",
          "cc",
          "cpp",
          "hpp",
          "cs",
          "php",
          "lua",
          "sql",
          "vue",
          "svelte"
        ],
        "name": "Codice sorgente",
        "description": "File di codice sorgente",
        "role": "Editor",
        "mimeType": "text/x-csrc;text/x-python;application/javascript"
      },
      {
        "ext": [
          "json",
          "jsonc",
          "yaml",
          "yml",
          "toml",
          "ini",
          "env",
          "conf"
        ],
        "name": "Configurazione",
        "description": "File di configurazione",
        "role": "Editor",
        "mimeType": "application/json;application/yaml;application/toml"
      },
      {
        "ext": [
          "css",
          "scss",
          "less",
          "html",
          "htm",
          "svg"
        ],
        "name": "Web",
        "description": "File web",
        "role": "Editor",
        "mimeType": "text/css;text/html;image/svg+xml"
      },
      {
        "ext": [
          "sh",
          "bash",
          "zsh",
          "fish"
        ],
        "name": "Script di shell",
        "description": "Script di shell",
        "role": "Editor",
        "mimeType": "application/x-shellscript"
      },
      {
        "ext": [],
        "name": "Cartella di progetto",
        "description": "Cartella di progetto",
        "role": "Viewer",
        "mimeType": "inode/directory"
      }
    ],
    "externalBin": [
      "binaries/topics-server",
      "binaries/pty-bridge",
      "binaries/webrtc-bridge"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": [
      "../../public/"
    ]
  }
}
