{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Topics",
  "version": "0.1.0",
  "identifier": "io.armonia.topics.tauri",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Topics",
        "width": 1400,
        "height": 900,
        "center": true,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 12 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:13333 ws://127.0.0.1:13333 ipc: http://ipc.localhost; img-src 'self' data: blob: http://127.0.0.1:13333; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMUIwQTM1MzNDOTJCQjAKUldTd0s4a3pOUW9iV29YUkVMLzdsT01xZFMvSXpRdjJGRDFVTkxvSDhDRUhQT0lDdDJZcURwaEUK",
      "endpoints": [
        "https://github.com/armonia/topics-app/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
