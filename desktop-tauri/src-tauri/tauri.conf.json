{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Topics",
  "version": "2.2.145",
  "identifier": "io.armonia.topics.tauri",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Topics",
        "width": 1400,
        "height": 900,
        "center": true,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 12
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMUIwQTM1MzNDOTJCQjAKUldTd0s4a3pOUW9iV29YUkVMLzdsT01xZFMvSXpRdjJGRDFVTkxvSDhDRUhQT0lDdDJZcURwaEUK",
      "endpoints": [
        "https://github.com/armonia/topics-app/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/topics-server",
      "binaries/pty-bridge",
      "binaries/webrtc-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
