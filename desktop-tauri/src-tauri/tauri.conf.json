{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Topics",
  "version": "0.1.0",
  "identifier": "io.armonia.topics.tauri",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Topics",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 12 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
