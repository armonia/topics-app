def load_state():
    try:
        with open(STATE) as f:
            s = json.load(f)
    except Exception:
        s = {}
    s.setdefault("slots", {})
    return s


def save_state(s):
    os.makedirs(ST, exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1)
    os.replace(tmp, STATE)


class Lock:
    def __init__(self, name):
        self.path = os.path.join(ST, name + ".lock")

    def __enter__(self):
        import fcntl
        os.makedirs(ST, exist_ok=True)
        self.f = open(self.path, "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        self.f.close()


# ── Hetzner e Topics ────────────────────────────────────────────────────────────

def token():
    t = os.environ.get("HCLOUD_TOKEN") or subprocess.run(
        ["security", "find-generic-password", "-s", "hcloud", "-a", "topics-nodes", "-w"],
        capture_output=True, text=True).stdout.strip()
    if not t:
        raise SystemExit("node-pool: token Hetzner hcloud/topics-nodes non leggibile")
    return t


def hz(method, path, body=None):
    req = urllib.request.Request(API + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"Bearer {token()}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            raw = r.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read())
        except Exception:
            return {"error": {"code": str(e.code), "message": str(e)}}


_CTX = ssl.create_default_context()
_CTX.check_hostname = False
_CTX.verify_mode = ssl.CERT_NONE


def mac(method, path, body=None, timeout=30):
    req = urllib.request.Request(MAC + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout, context=_CTX) as r:
        return json.loads(r.read() or b"{}")


def pool_servers():
    return [s for s in hz("GET", "/servers?label_selector=topics-node&per_page=50").get("servers", [])
            if (s.get("labels") or {}).get("topics-node-slot") and s.get("name") != PERMANENT_NAME]


def price(type_name, location):
    st = hz("GET", f"/server_types?name={type_name}").get("server_types", [])
    for p in (st[0]["prices"] if st else []):
        if p["location"] == location:
            return float(p["price_hourly"]["gross"])
    return 0.0


def latest_snapshot():
    imgs = hz("GET", "/images?type=snapshot&label_selector=topics-node&sort=created:desc").get("images", [])
    return imgs[0] if imgs else None


def known_file(ip):
    """known_hosts per server: Hetzner riusa gli IP, e una chiave vecchia fa rifiutare ssh (10/11)."""
    return os.path.join(ST, "known", f"{ip}-{_SERVER_OF_IP.get(ip, 'x')}")


_SERVER_OF_IP = {}


# One shared connection per node: every short command used to be a fresh ssh login, ~5 a minute,
# each one a logind session on the node (card e809a470). Multiplexed commands are channels of
# the same session. ServerAliveInterval kills a dead master in ~45 s instead of hanging callers.
MUX_DIR = os.path.join(HOME, ".ssh", "cm")
MUX = ["-o", "ControlMaster=auto", "-o", f"ControlPath={MUX_DIR}/topics-node-%C", "-o", "ControlPersist=10m",
       "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3"]


def ssh(ip, cmd, timeout=120, inp=None):
    known = known_file(ip)
    os.makedirs(os.path.dirname(known), exist_ok=True)
    os.makedirs(MUX_DIR, mode=0o700, exist_ok=True)
    return subprocess.run(["ssh", "-i", KEY, "-o", "IdentitiesOnly=yes", "-o", "IPQoS=af41", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
                           *MUX, "-o", "StrictHostKeyChecking=accept-new", "-o", f"UserKnownHostsFile={known}", "-o", "LogLevel=ERROR",
                           f"root@{ip}", cmd], capture_output=True, text=True, timeout=timeout, input=inp)


def machine_row(slot):
    import sqlite3
    db = sqlite3.connect(f"file:{MAC_DB}?mode=ro", uri=True, timeout=5)
    try:
        r = db.execute("select id from machines where base_url=?", (f"http://127.0.0.1:{LPORT + slot}",)).fetchone()
        return r[0] if r else None
    finally:
        db.close()


def slot_busy(machine_id, running_only=False):
    """Card vive del posto sul Mac: in coda o al lavoro con questa macchina. While draining only
    the running ones count: queued cards cannot start with slots 0, they wait for the realign.
    A card waiting for a human answer (needs_input) has no turn in flight: counting it kept the
    node drained 3 h out of 4 for two days (21/11, one card unanswered since 19/11). A deferred card
    (`waiting`, it waits for a condition) has no turn either: on 26/11 one held the drain past midnight."""
    if not machine_id:
        return 0
    import sqlite3
    db = sqlite3.connect(f"file:{MAC_DB}?mode=ro", uri=True, timeout=5)
    try:
        states = "('in_progress')" if running_only else "('todo','in_progress')"
        return db.execute(f"select count(*) from tasks where machine_id=? and status in {states}"
                          " and coalesce(dispatch_state, '') not in ('needs_input', 'waiting')",
                          (machine_id,)).fetchone()[0]
    finally:
        db.close()


def slot_of_base(base):
    """Il solo posto che esiste è il permanente: nessun altro nasce più a richiesta."""
    return PERMANENT_SLOT if base.rstrip("/") == f"http://127.0.0.1:{LPORT + PERMANENT_SLOT}" else None


# ── ricetta ─────────────────────────────────────────────────────────────────────

def tools():
    apt, npm = [], []
    with open(STRUMENTI) as f:
        for line in f:
            c = line.split()
            if not c or c[0].startswith("#") or len(c) < 5:
                continue
            if c[3] != "-":
                apt.append(c[3])
            if c[4] != "-":
                npm.append(c[4])
    return apt, npm


def commit_of_mac():
    return subprocess.run(["git", "-C", APP_DIR, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()


def recipe():
    apt, npm = tools()
    node_major = subprocess.run(["node", "-v"], capture_output=True, text=True).stdout.strip().lstrip("v").split(".")[0] or "22"
    with open(os.path.join(HERE, "user-data.sh.tmpl")) as f:
        t = f.read()
    with open(os.path.join(HERE, "logind-stale-sessions")) as f:
        guard = f.read().rstrip("\n")
    return (t.replace("@LOGIND_GUARD@", guard).replace("@APT@", " ".join(apt)).replace("@NPM@", " ".join(npm))
             .replace("@NODE_MAJOR@", node_major).replace("@COMMIT@", commit_of_mac()))


def from_snapshot_user_data():
    """Il nodo da snapshot ha già tutto: si allinea al commit del Mac e riparte."""
    c = commit_of_mac()
    return f"""#!/bin/bash
su - topics -c 'cd topics-app && git fetch -q origin && git checkout -q {c} && export PATH="$HOME/.topics/bun/$(tr -d "[:space:]" < .bun-version):$PATH" && bun install >/dev/null 2>&1' > /var/log/topics-align.log 2>&1
systemctl restart topics.service
touch /var/lib/topics-node-ready
"""


# ── vita di un nodo ─────────────────────────────────────────────────────────────

def create_server(slot, snapshot=True, name=None):
    """Crea il server del posto. Ritorna (server, eur_h) o (None, motivo)."""
    img = latest_snapshot() if snapshot else None
    ud = from_snapshot_user_data() if img else recipe()
    labels = {"topics-node": "1", "expires": str(int(time.time()) + EXPIRES_S)}
    if slot:
        labels["topics-node-slot"] = str(slot)
    last = "nessun tipo provato"
    for t in TYPES:
        p = subprocess.run([TETTO_BIN, "puo", t, "--pool"], capture_output=True, text=True)
        if p.returncode != 0:
            last = f"{t}: tetto dice no ({p.stdout.strip() or p.stderr.strip()})"
            log(last)
            continue
        for loc in LOCATIONS:
            r = hz("POST", "/servers", {"name": name or f"topics-node-p{slot}", "server_type": t, "location": loc,
                                       "image": img["id"] if img else "ubuntu-24.04", "ssh_keys": ["topics-node"],
                                       "user_data": ud, "labels": labels, "start_after_create": True})
            if r.get("server"):
                eur = price(t, loc)
                log(f"creato {r['server']['name']} id={r['server']['id']} {t} {loc} {eur} €/h da {'snapshot ' + str(img['id']) if img else 'ricetta'}")
                return r["server"], eur
            err = r.get("error", {})
            last = f"{t} {loc}: {err.get('code')} {err.get('message')}"
            log(f"creazione rifiutata: {last}")
            if err.get("code") in ("resource_limit_exceeded", "forbidden", "invalid_input"):
                break
    return None, last


def wait_ready(server, timeout=BOOT_MAX_S):
    t0 = time.time()
    ip = None
    while time.time() - t0 < timeout:
        s = hz("GET", f"/servers/{server['id']}").get("server") or {}
        ip = ((s.get("public_net") or {}).get("ipv4") or {}).get("ip") or ip
        if ip:
            _SERVER_OF_IP[ip] = server["id"]
        if ip and s.get("status") == "running":
            try:
                r = ssh(ip, "test -f /var/lib/topics-node-ready && curl -s -m 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:3333/__daemon/healthz", timeout=20)
                if r.returncode == 0 and r.stdout.strip() not in ("", "000"):
                    return ip
            except subprocess.TimeoutExpired:
                pass
        time.sleep(5)
    return None


def tunnel_alive(sl):
    pid = sl.get("tunnel_pid")
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return subprocess.run(["nc", "-z", "-G", "2", "127.0.0.1", str(LPORT + sl["n"])], capture_output=True).returncode == 0


def open_tunnel(sl):
    _SERVER_OF_IP[sl["ip"]] = sl["server_id"]
    if tunnel_alive(sl):
        return True
    known = known_file(sl['ip'])
    p = subprocess.Popen(["ssh", "-N", "-i", KEY, "-o", "IdentitiesOnly=yes", "-o", "IPQoS=af41", "-o", "BatchMode=yes", "-o", "ExitOnForwardFailure=yes",
                          "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3", "-o", "StrictHostKeyChecking=accept-new",
                          "-o", f"UserKnownHostsFile={known}", "-L", f"127.0.0.1:{LPORT + sl['n']}:127.0.0.1:3341",
                          "-R", f"127.0.0.1:{rport(sl)}:127.0.0.1:{PROXY}", f"root@{sl['ip']}"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    sl["tunnel_pid"] = p.pid
    for _ in range(20):
        if tunnel_alive(sl):
            return True
        time.sleep(1)
    return False


def close_tunnel(sl):
    pid = sl.pop("tunnel_pid", None)
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass


def pair(sl):
    """Appaia il nodo appena nato col Mac: il Mac apre, il nodo approva da loopback (proprietario)."""
    base = f"http://127.0.0.1:{LPORT + sl['n']}"
    opened = mac("POST", "/api/machines/pair", {"baseUrl": base})
    for _ in range(30):
        r = ssh(sl["ip"], "curl -s -m 5 http://127.0.0.1:3333/api/auth/pair/pending", timeout=20)
        try:
            reqs = json.loads(r.stdout or "{}").get("requests", [])
        except Exception:
            reqs = []
        req = next((q for q in reqs if q.get("code") == opened["code"]), None)
        if req:
            body = json.dumps({"requestId": req["id"], "role": "owner"})
            ssh(sl["ip"], f"curl -s -m 5 -X POST -H 'Content-Type: application/json' -d '{body}' http://127.0.0.1:3333/api/auth/pair/approve", timeout=20)
            break
        time.sleep(2)
    for _ in range(30):
        g = mac("GET", f"/api/machines/pair/{opened['pairingId']}")
        if g.get("state") == "approved":
            return g["machine"]["id"]
        if g.get("state") not in ("pending",):
            raise RuntimeError(f"appaiamento: {g.get('state')}")
        time.sleep(2)
    raise RuntimeError("appaiamento: nessuna risposta")


def wire_model(sl):
    """Il CLI del nodo usa i modelli del Mac dal tunnel -R: nessun login sul nodo."""
    tok = mac("POST", f"/api/machines/{sl['machine_id']}/model-token")["token"]
    env = {"ANTHROPIC_BASE_URL": f"http://127.0.0.1:{rport(sl)}", "ANTHROPIC_AUTH_TOKEN": tok}
    settings = json.dumps({"env": env})
    dropin = "[Service]\n" + "".join(f"Environment={k}={v}\n" for k, v in env.items())
    script = (f"mkdir -p /home/topics/.claude /etc/systemd/system/topics.service.d && "
              f"echo {base64.b64encode(settings.encode()).decode()} | base64 -d > /home/topics/.claude/settings.json && "
              f"echo {base64.b64encode(dropin.encode()).decode()} | base64 -d > /etc/systemd/system/topics.service.d/model.conf && "
              f"chmod 600 /etc/systemd/system/topics.service.d/model.conf && chown -R topics:topics /home/topics/.claude && "
              f"systemctl daemon-reload && systemctl restart topics.service")
    r = ssh(sl["ip"], script, timeout=60)
    if r.returncode != 0:
        raise RuntimeError(f"modello sul nodo: {r.stderr.strip()[-200:]}")
    for _ in range(60):
        r = ssh(sl["ip"], "curl -s -m 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:3333/__daemon/healthz", timeout=20)
        if r.stdout.strip() not in ("", "000"):
            break
        time.sleep(2)
    ssh(sl["ip"], "curl -s -m 5 -X PATCH -H 'Content-Type: application/json' -d '{\"autoDispatch\":true}' http://127.0.0.1:3333/api/all-boards/settings", timeout=20)
    try:
        mac("PATCH", f"/api/machines/{sl['machine_id']}", {"name": f"Nodo cloud {sl['n']}"})
        mac("PATCH", f"/api/machines/{sl['machine_id']}", {"slots": SLOTS_PER_NODE})
    except Exception as e:
        log(f"posto {sl['n']}: slots non impostati: {e}")


def bring_up(state, n, reason):
    """Accende il posto permanente: tunnel, appaiamento, modelli. Ritorna lo slot o None. Non esiste
    più un posto a richiesta da creare: se non è il posto 1, o il nodo permanente non c'è, non fa nulla."""
    if n != PERMANENT_SLOT:
        log(f"posto {n}: non esiste (solo il posto {PERMANENT_SLOT}, il nodo permanente)")
        return None
    fx = permanent_server()
    if not fx:
        log("nodo permanente non trovato su Hetzner")
        return None
    return ensure_permanent(state, fx)


def finish(state, sl, t0=None):
    """Dal server acceso al nodo pronto: tunnel, appaiamento, modelli. Riprendibile: se un hook viene
    interrotto a metà (timeout di Topics), il giro o il hook dopo ripartono da qui."""
    n = sl["n"]
    t0 = t0 or sl.get("created") or time.time()
    if sl.get("ip"):
        _SERVER_OF_IP[sl["ip"]] = sl["server_id"]
    if not sl.get("ip"):
        ip = wait_ready({"id": sl["server_id"]})
        if not ip:
            log(f"posto {n}: {sl.get('name')} non pronto, cancellato")
            delete(state, n, "non pronto")
            return None
        sl["ip"] = ip
        save_state(state)
    try:
        if not open_tunnel(sl):
            raise RuntimeError("tunnel non aperto")
        sl["machine_id"] = pair(sl)
        wire_model(sl)
    except Exception as e:
        log(f"posto {n}: {e}; cancellato")
        delete(state, n, str(e))
        return None
    sl.pop("creating", None)
    sl["ready"] = True
    save_state(state)
    log(f"posto {n}: {sl['name']} pronto in {int(time.time() - t0)}s (macchina {sl['machine_id']}, ip {sl['ip']})")
    return sl


def forget_machine(machine_id):
    """Toglie dal Mac la riga della macchina di un server a ore appena cancellato: senza, resta per
    sempre come «Nodo cloud N» spento, un fantasma che la tray e la lista dei nodi continuano a
    mostrare. Con una card ancora legata alla riga il Mac risponde 409: la riga resta, il prossimo
    appaiamento sullo stesso posto la riprende. Non solleva mai: la cancellazione del server è già fatta."""
    if not machine_id:
        return
    try:
        mac("DELETE", f"/api/machines/{machine_id}")
        log(f"macchina {machine_id} tolta dal Mac")
    except Exception as e:
        log(f"macchina {machine_id} non tolta dal Mac: {e}")


def delete(state, n, reason):
    sl = state["slots"].get(str(n)) or {}
    close_tunnel(sl)
    sid = sl.get("server_id")
    if sl.get("fixed"):
        # il nodo permanente non si cancella mai: si chiude il tunnel e il giro dopo lo riprende
        state["slots"][str(n)] = {"n": n, "machine_id": sl.get("machine_id")}
        save_state(state)
        log(f"posto {n}: {sl.get('name')} (permanente) staccato, non cancellato: {reason}")
        return
    if sid:
        if sl.get("ip"):
            _SERVER_OF_IP[sl["ip"]] = sid
        ssh(sl["ip"], "systemctl stop topics.service", timeout=30) if sl.get("ip") else None
        hz("DELETE", f"/servers/{sid}")
        log(f"cancellato {sl.get('name')} id={sid}: {reason}")
    forget_machine(sl.get("machine_id"))
    state["slots"][str(n)] = {"n": n}
    save_state(state)
    # tray e `hetzner-tetto json` leggono il registro del tetto: va riscritto subito, non al giro dopo
    if sid:
        subprocess.run([TETTO_BIN, "stato"], capture_output=True, timeout=60)


# ── nodo permanente ────────────────────────────────────────────────────────────────

def permanent_server():
    return next(iter(hz("GET", f"/servers?name={PERMANENT_NAME}").get("servers") or []), None)


def ensure_permanent(state, fx):
    """Il posto 1 è il nodo permanente: lo collega (tunnel, appaiamento, modelli) se non lo è,
    poi tiene le sue card a 2 o 4 secondo la CI e lo riallinea al commit del Mac quando è fermo."""
    ip = ((fx.get("public_net") or {}).get("ipv4") or {}).get("ip")
    _SERVER_OF_IP[ip] = fx["id"]
    key = str(PERMANENT_SLOT)
    sl = state["slots"].get(key) or {"n": PERMANENT_SLOT}
    if sl.get("server_id") != fx["id"]:
        if sl.get("server_id"):
            delete(state, PERMANENT_SLOT, "il posto passa al nodo permanente")
        sl = {"n": PERMANENT_SLOT, "machine_id": (state["slots"].get(key) or {}).get("machine_id")}
        state["slots"][key] = sl
    fc = fixed_cost(fx)
    if fc:
        state["fixed_cost"] = fc
    sl.update({"server_id": fx["id"], "name": fx["name"], "fixed": True, "provider": PROVIDER_LABEL, "ip": ip, "eur_h": 0.0,
               "created": sl.get("created") or time.time(), "idle_since": None})
    if not sl.get("ready"):
        if fx.get("status") != "running":
            return None
        r = ssh(ip, "test -f /var/lib/topics-node-ready", timeout=20)
        if r.returncode != 0:
            return None  # ricetta ancora in corso
        log(f"posto {key}: collego il nodo permanente {fx['name']} ({ip})")
        return finish(state, sl)
    if not tunnel_alive(sl):
        log(f"posto {key}: tunnel del nodo permanente riaperto ({open_tunnel(sl)})")
    # -x: -f would also count the shell that runs pgrep, and the CI would always look busy
    r = ssh(ip, "pgrep -c -x Runner.Worker", timeout=20)
    out = (r.stdout or "").split()
    ci_busy = int(out[0]) if out and out[0].isdigit() else 0
    want = sl["slots"] if sl.get("capped") and sl.get("slots") is not None else permanent_slots(ci_busy)
    if sl.get("slots") != want and sl.get("machine_id"):
        try:
            mac("PATCH", f"/api/machines/{sl['machine_id']}", {"slots": want})
            sl["slots"] = want
            log(f"posto {key}: card del nodo permanente a {want} (CI {'al lavoro' if ci_busy else 'ferma'})")
        except Exception as e:
            log(f"posto {key}: slots del nodo permanente non impostati: {e}")
    align_permanent(sl, ip, key, commit_of_mac(), ci_busy)
    save_state(state)
    return sl


def set_slots(sl, key, n):
    try:
        mac("PATCH", f"/api/machines/{sl['machine_id']}", {"slots": n})
        sl["slots"] = n
        return True
    except Exception as e:
        log(f"posto {key}: slots del nodo permanente non impostati: {e}")
        return False


LOSSLESS_PROBE = (
    "su - topics -c 'd=\"$HOME/.topics/daemon-state.json\"; "
    "t=$(sed -n \"s/.*\\\"token\\\"[[:space:]]*:[[:space:]]*\\\"\\([0-9a-f]\\{64\\}\\)\\\".*/\\1/p\" \"$d\" | head -1); "
    "p=$(sed -n \"s/.*\\\"port\\\"[[:space:]]*:[[:space:]]*\\([0-9]\\{1,5\\}\\).*/\\1/p\" \"$d\" | head -1); "
    "for s in https http; do curl -sk -m 5 -H \"Authorization: Bearer $t\" $s://127.0.0.1:$p/__daemon/healthz && break; done'"
)


def node_lossless(ip):
    """True when the running server says a restart loses no turn (healthz `losslessRestart`):
    its native turns live under the AI broker, which survives the restart."""
    r = ssh(ip, LOSSLESS_PROBE, timeout=30)
    return r.returncode == 0 and '"losslessRestart":true' in (r.stdout or "").replace(" ", "")


def align_permanent(sl, ip, key, c, ci_busy, now=None):
    """Realign the node to the Mac commit WITHOUT ever taking slots away: a drain left the node at
    0 slots for hours behind long cards (measured 24-25/11: 7 drains, ~22 h in 27). Realign as soon as
    no turn is in flight; if the node's server restarts losslessly, also with turns in flight."""
    now = now or time.time()
    # «aligned», not HEAD: a checkout that worked with a failed `bun install` moves HEAD
    # while the running node is still the old one
    if not c or sl.get("aligned") == c or sl.get("align_failed") == c:
        sl.pop("behind_since", None)
        sl["draining"] = False
        if sl.pop("capped", None) and sl.get("machine_id"):
            set_slots(sl, key, permanent_slots(ci_busy))
        # un fallimento è del commit che non è passato: se il nodo è già a quello del Mac non ce n'è più
        # (la tray lo leggeva per sempre come «riallineamento fallito»)
        if sl.get("aligned") == c:
            sl.pop("align_failed", None)
        return
    sl.setdefault("behind_since", now)
    if sl.get("draining"):
        # state left by an older version of this loop: give the slots back
        sl["draining"] = False
        sl.pop("drain_until", None)
        set_slots(sl, key, permanent_slots(ci_busy))
    # cards without a turn in flight (waiting on a person) do not hold the restart
    running = slot_busy(sl.get("machine_id"), running_only=True)
    if running and not node_lossless(ip):
        if now - sl["behind_since"] >= BEHIND_S and sl.get("machine_id"):
            # no new cards: the slots follow the running ones down, so the node frees up and realigns
            if not sl.get("capped"):
                log(f"posto {key}: nodo indietro da {int((now - sl['behind_since']) / 60)} min, niente card nuove ({running} in corso)")
            sl["capped"] = True
            if sl.get("slots") != running:
                set_slots(sl, key, running)
        return
    # restart only if the checkout succeeded: a commit of the Mac not yet on origin would
    # otherwise restart Topics every minute; a failed commit is not retried until the next one
    a = ssh(ip, "su - topics -c 'cd topics-app && git fetch -q origin && git checkout -q " + c +
            " && export PATH=\"$HOME/.topics/bun/$(tr -d \"[:space:]\" < .bun-version):$PATH\" && bun install >/dev/null 2>&1'"
            " && systemctl restart topics.service", timeout=600)
    if a.returncode != 0:
        sl["align_failed"] = c
    else:
        sl["aligned"] = c
        sl.pop("align_failed", None)
    global _REALIGNED
    _REALIGNED = _REALIGNED or a.returncode == 0
    log(f"posto {key}: nodo permanente riallineato a {c[:10]} (exit {a.returncode})")
    sl.pop("behind_since", None)
    if sl.pop("capped", None):
        set_slots(sl, key, permanent_slots(ci_busy))


# Files copied to the permanent node before ci-runners.sh runs: the runners script and the CI governor.
PERMANENT_FILES = ("ci-runners.sh", "ci-governor.py", "ci-governor.service")


def push_permanent_files(ip, known):
    pdir = os.path.join(HERE, "..", "permanent-node")
    for f in PERMANENT_FILES:
        subprocess.run(["scp", "-q", "-i", KEY, "-o", "IPQoS=none", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new",
                        "-o", f"UserKnownHostsFile={known}", os.path.join(pdir, f), f"root@{ip}:/root/{f}"], check=True, timeout=120)


def permanent_ci():
    """Runner della CI sul nodo permanente: token di registrazione e di rimozione da gh (valgono
    un'ora, mai su disco); quello di rimozione serve a un runner registrato con un altro nome."""
    fx = permanent_server()
    if not fx:
        raise SystemExit(f"node-pool: nessun server {PERMANENT_NAME}")
    ip = fx["public_net"]["ipv4"]["ip"]
    _SERVER_OF_IP[ip] = fx["id"]

    def gh_token(kind):
        return subprocess.run(["gh", "api", "-X", "POST", f"repos/{CI_REPO}/actions/runners/{kind}", "--jq", ".token"],
                              capture_output=True, text=True, timeout=60).stdout.strip()
    tok, rm_tok = gh_token("registration-token"), gh_token("remove-token")
    if not tok or not rm_tok:
        raise SystemExit("node-pool: gh non dà i token di registrazione e rimozione dei runner")
    known = known_file(ip)
    os.makedirs(os.path.dirname(known), exist_ok=True)
    push_permanent_files(ip, known)
    r = ssh(ip, f"read -r REG_TOKEN; read -r REMOVE_TOKEN; export REG_TOKEN REMOVE_TOKEN; N={CI_RUNNERS} bash /root/ci-runners.sh",
            timeout=1800, inp=f"{tok}\n{rm_tok}\n")
    print(r.stdout.strip()[-500:], r.stderr.strip()[-1500:], sep="\n")
    return r.returncode


