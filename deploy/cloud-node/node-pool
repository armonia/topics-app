_REALIGNED = False   # vero se in questo giro il nodo permanente è stato riallineato al codice del Mac


def fixed_cost(fx):
    """Prezzi del nodo permanente come li fattura Hetzner: €/h e tetto mensile, per spend_daily."""
    try:
        loc = ((fx.get("datacenter") or {}).get("location") or fx.get("location") or {}).get("name")
        prices = fx["server_type"]["prices"]
        p = next((p for p in prices if p["location"] == loc), prices[0])
        # «Z» finale: fromisoformat lo capisce solo da Python 3.11, e il giro può girare col python di sistema
        created = datetime.datetime.fromisoformat(fx["created"].replace("Z", "+00:00")).timestamp()
        return {"name": fx["name"], "created": created, "eur_h": float(p["price_hourly"]["gross"]),
                "eur_month": float(p["price_monthly"]["gross"])}
    except Exception:
        return None


def harness_targets(state):
    """I nodi pronti da servire: quelli con server, indirizzo e riga `machines`."""
    out = []
    for key, sl in sorted(state["slots"].items()):
        if sl.get("ready") and sl.get("ip") and sl.get("machine_id") and sl.get("server_id"):
            _SERVER_OF_IP[sl["ip"]] = sl["server_id"]
            out.append({"machine_id": sl["machine_id"], "name": sl.get("name") or f"Nodo cloud {key}", "kind": "linux",
                        "ip": sl["ip"], "key": KEY, "known_hosts": known_file(sl["ip"])})
    return out


def run_harness_sync(targets, force=False):
    """Lancia harness-sync staccato: un primo trasferimento di centinaia di MB non deve fermare il giro.
    Il tetto «al più ogni 15 minuti» e il lucchetto stanno dentro harness-sync. Non solleva mai."""
    if not os.path.exists(HARNESS_SYNC):
        return False
    try:
        p = subprocess.Popen([sys.executable, HARNESS_SYNC, "run", "--targets", "-"] + (["--force"] if force else []),
                             stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        p.stdin.write(json.dumps(targets).encode())
        p.stdin.close()
        return True
    except Exception as e:
        log(f"harness-sync non partito: {e}")
        return False


