def giro():
    sweep_stale_bundles()
    with Lock("giro"):
        state = load_state()
        now = time.time()
        fx = permanent_server()
        if fx:
            try:
                ensure_permanent(state, fx)
            except Exception as e:
                log(f"nodo permanente: {e}")
        known = {sl.get("server_id") for sl in state["slots"].values()}
        # raccoglitore: server Hetzner col label che il registro non conosce più, se scaduti
        for s in pool_servers():
            exp = int((s.get("labels") or {}).get("expires", "0") or 0)
            if s["id"] not in known and exp and exp < now:
                hz("DELETE", f"/servers/{s['id']}")
                log(f"raccolto {s['name']} id={s['id']}: scaduto e sconosciuto al registro")
        # carico di ogni posto per la tray: «acceso, N card». Solo lettura del DB del Mac.
        for sl in state["slots"].values():
            if sl.get("machine_id") and (sl.get("server_id") or sl.get("fixed")):
                try:
                    sl["cards"] = slot_busy(sl["machine_id"])
                except Exception:
                    pass
        state["spend_daily"] = spend_daily(state.get("fixed_cost"), now)
        state["spend_cap_eur"] = SPEND_CAP_EUR
        save_state(state)
        run_harness_sync(harness_targets(state), force=_REALIGNED)
    return 0


def hook():
    sweep_stale_bundles()
    try:
        payload = json.load(sys.stdin)
    except Exception:
        payload = {}
    n = slot_of_base(payload.get("node_base_url") or "")
    if not n:
        return 0  # non è un posto del pool
    with Lock(f"slot{n}"):
        state = load_state()
        sl = state["slots"].get(str(n)) or {}
        if not sl.get("server_id"):
            log(f"hook: card {payload.get('task_id')} chiede il posto {n} spento, lo accendo")
            sl = bring_up(state, n, f"card {payload.get('task_id')} assegnata al posto")
            if not sl:
                print(f"il nodo cloud {n} non si è acceso (log: {LOG})", file=sys.stderr)
                return 2
        elif not sl.get("ready"):
            log(f"hook: posto {n} acceso ma non pronto, riprendo")
            sl = finish(state, sl)
            if not sl:
                print(f"il nodo cloud {n} non si è acceso (log: {LOG})", file=sys.stderr)
                return 2
        elif not tunnel_alive(sl):
            open_tunnel(sl)
            save_state(state)
        sl["idle_since"] = None
        save_state(state)
    origin, repo = payload.get("origin_url"), payload.get("cwd")
    if origin and repo:
        git_name, git_email = payload.get("git_author_name") or "", payload.get("git_author_email") or ""
        if not git_name and not git_email:
            # The dispatcher already refuses to send a card here without one (card
            # 5d361c3d); this is only the floor for whoever calls the hook directly.
            print(f"il checkout {repo} non ha un'identità git (git config user.name/user.email): "
                  "la corsa non parte, il land rifiuterebbe i suoi commit", file=sys.stderr)
            return 2
        with Lock(f"repo{n}-{origin.rstrip('/').split('/')[-1]}"):
            sync_repo(sl, origin, repo, git_name, git_email)
    return 0


BUNDLE_SUFFIX = ".bundle"
# Longer than the worst live bundle: 300 s to create it plus 600 s of scp.
STALE_BUNDLE_S = 3600


def _pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def sweep_stale_bundles(now=None, state_dir=None):
    """Remove the bundles a previous run left in the state dir: the process that wrote one is gone,
    or it is older than any live transfer. Returns the names removed. Runs at the start of every
    `giro` and `hook`, so a leak from before the try/finally (or a SIGKILL) is gone within a minute."""
    now = time.time() if now is None else now
    d = state_dir or ST
    removed = []
    try:
        names = os.listdir(d)
    except FileNotFoundError:
        return removed
    for f in names:
        if not f.endswith(BUNDLE_SUFFIX):
            continue
        path = os.path.join(d, f)
        pid_part = f[: -len(BUNDLE_SUFFIX)].rsplit("-", 1)[-1]
        pid = int(pid_part) if pid_part.isdigit() else None
        try:
            age = now - os.path.getmtime(path)
        except FileNotFoundError:
            continue
        mine = pid == os.getpid()
        if mine or (pid is not None and _pid_alive(pid) and age < STALE_BUNDLE_S):
            continue
        try:
            os.remove(path)
            removed.append(f)
        except FileNotFoundError:
            pass
    if removed:
        log(f"bundle rimasti tolti: {len(removed)}")
    return removed


def sync_repo(sl, origin, repo, git_name, git_email):
    """Il ramo di default del repo va sul nodo con un git bundle (anche i repo privati: il nodo non ha token).
    Il clone sul nodo firma i suoi commit con l'identità di QUESTO checkout (letta dal Mac dal dispatcher),
    non con una propria: altrimenti il land (LAND-13) la rifiuta come autore estraneo."""
    name = origin.rstrip("/").split("/")[-1].removesuffix(".git")
    d = f"/home/topics/repos/{name}"
    subprocess.run(["git", "-C", repo, "fetch", "-q", "--no-tags", "origin"], capture_output=True, timeout=120)
    head = subprocess.run(["git", "-C", repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], capture_output=True, text=True).stdout.strip() or "origin/main"
    branch = head.split("/", 1)[1]
    ref = f"refs/remotes/origin/{branch}"
    bundle = os.path.join(ST, f"{name}-{os.getpid()}{BUNDLE_SUFFIX}")
    # The local bundle goes in every outcome: a failed or timed-out scp used to leave it here,
    # and nothing else ever removed it (26 bundles, 2.7 GB in ten days).
    try:
        b = subprocess.run(["git", "-C", repo, "bundle", "create", bundle, ref], capture_output=True, text=True, timeout=300)
        if b.returncode != 0:
            raise SystemExit(f"node-pool: git bundle fallito: {b.stderr[-200:]}")
        _SERVER_OF_IP[sl["ip"]] = sl["server_id"]
        known = known_file(sl['ip'])
        subprocess.run(["scp", "-q", "-i", KEY, "-o", "IPQoS=none", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new", "-o", f"UserKnownHostsFile={known}", bundle, f"root@{sl['ip']}:/tmp/{os.path.basename(bundle)}"], check=True, timeout=600)
    finally:
        try:
            os.remove(bundle)
        except FileNotFoundError:
            pass
    # base64, not shell-quoted: a name/email may carry an apostrophe, and this whole block already
    # sits inside a single-quoted `su -c '...'` that a stray one would break out of.
    name64 = base64.b64encode(git_name.encode()).decode()
    email64 = base64.b64encode(git_email.encode()).decode()
    script = f"""set -e
B=/tmp/{os.path.basename(bundle)}
trap 'rm -f $B' EXIT
chmod 644 $B
su - topics -c '
set -e
d={d}
if [ ! -d $d/.git ]; then mkdir -p $d && git init -q $d && git -C $d remote add origin {origin}; fi
git -C $d fetch -q '$B' "+{ref}:{ref}"
git -C $d symbolic-ref refs/remotes/origin/HEAD {ref}
if ! git -C $d rev-parse -q --verify HEAD >/dev/null; then git -C $d checkout -q -B {branch} {ref}
elif [ -z "$(git -C $d status --porcelain)" ]; then git -C $d checkout -q {branch} && git -C $d merge -q --ff-only {ref} || true; fi
git -C $d config user.name "$(echo {name64} | base64 -d)"
git -C $d config user.email "$(echo {email64} | base64 -d)"
'
rm -f $B
curl -s -m 10 http://127.0.0.1:3333/api/projects | grep -q '"path":"{d}"' || curl -s -m 10 -X POST -H 'Content-Type: application/json' -d '{{"name":"{name}","slug":"{name.lower()}","path":"{d}"}}' http://127.0.0.1:3333/api/projects >/dev/null
"""
    r = ssh(sl["ip"], script, timeout=300)
    if r.returncode != 0:
        raise SystemExit(f"node-pool: repo sul nodo: {r.stderr.strip()[-300:]}")
    log(f"posto {sl['n']}: {name} portato a {branch}")


def snapshot():
    """Rifà lo snapshot dalla ricetta unica: server a ore, ricetta, pulizia, immagine, server cancellato."""
    server, eur = create_server(None, snapshot=False, name=f"topics-node-snap-{int(time.time())}")
    if not server:
        raise SystemExit(f"node-pool: snapshot, nessun server ({eur})")
    t0 = time.time()
    try:
        ip = wait_ready(server, timeout=1500)
        if not ip:
            raise SystemExit("node-pool: la ricetta non arriva a pronto in 25 minuti")
        log(f"snapshot: ricetta pronta in {int(time.time() - t0)}s")
        ssh(ip, "systemctl stop topics.service; rm -f /home/topics/topics-app/data/topics.db* /var/lib/topics-node-ready; "
                "rm -rf /home/topics/topics-app/.topics-secrets /home/topics/.claude/.credentials.json /home/topics/.codex/auth.json; "
                "cloud-init clean --logs; sync", timeout=120)
        r = hz("POST", f"/servers/{server['id']}/actions/create_image",
               {"type": "snapshot", "description": f"topics-node {commit_of_mac()[:10]}", "labels": {"topics-node": "1"}})
        img = r["image"]["id"]
        while hz("GET", f"/images/{img}")["image"]["status"] != "available":
            time.sleep(5)
        for old in hz("GET", "/images?type=snapshot&label_selector=topics-node").get("images", []):
            if old["id"] != img:
                hz("DELETE", f"/images/{old['id']}")
        log(f"snapshot {img} pronto ({hz('GET', f'/images/{img}')['image'].get('image_size')} GB)")
    finally:
        hz("DELETE", f"/servers/{server['id']}")
        log(f"snapshot: server {server['name']} cancellato dopo {int((time.time() - t0) / 60)} min ({eur} €/h)")
    return 0


def stato():
    state = load_state()
    now = time.time()
    fx_spend = sum(d["eur"] for d in spend_daily(state.get("fixed_cost"), now))
    cap = (state.get("fixed_cost") or {}).get("eur_month")
    print(f"nodo fisso: {fx_spend:.2f} € del mese" + (f" su {cap:.0f} €" if cap else ""))
    for k, sl in sorted(state["slots"].items()):
        if sl.get("server_id"):
            print(f"posto {k}: {sl.get('name')} id={sl['server_id']} da {int((now - sl['created']) / 60)} min, "
                  f"card {slot_busy(sl.get('machine_id'))}, ferma da {int((now - sl['idle_since']) / 60) if sl.get('idle_since') else 0} min")
        else:
            print(f"posto {k}: spento")
    for s in pool_servers():
        print(f"hetzner: {s['name']} id={s['id']} {s['server_type']['name']} {s['status']}")
    return 0


def spegni():
    state = load_state()
    for k, sl in state["slots"].items():
        if sl.get("server_id") and not sl.get("fixed"):
            delete(state, int(k), "spegni")
    for s in pool_servers():
        hz("DELETE", f"/servers/{s['id']}")
    return 0


