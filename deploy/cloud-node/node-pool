# ── decisioni pure (le prova --selftest) ───────────────────────────────────────

def billed_hours(created, end):
    """Hetzner arrotonda all'ora per eccesso: 20 minuti = 1 ora, 61 = 2."""
    return max(1, math.ceil((end - created) / 3600))


def _day(ts):
    return time.strftime("%Y-%m-%d", time.localtime(ts))


def spend_daily(fixed, now):
    """Spesa del mese corrente giorno per giorno: [{day, eur}] dal primo a oggi. Ogni ora pagata va al giorno in cui
    comincia (Hetzner fattura a ore intere per eccesso). Il nodo permanente costa le sue ore del mese al prezzo orario
    fino al prezzo mensile, come in hetzner-tetto; senza il suo dato non c'è spesa da riportare."""
    lt = time.localtime(now)
    month = time.strftime("%Y-%m", lt)
    first = time.mktime((lt.tm_year, lt.tm_mon, 1, 0, 0, 0, 0, 0, -1))
    days = {}
    for dd in range(1, 32):
        ts = time.mktime((lt.tm_year, lt.tm_mon, dd, 0, 0, 0, 0, 0, -1))
        if _day(ts).startswith(month) and ts <= now:
            days[_day(ts)] = 0.0

    def charge(start, hours, eur_h, cap=None):
        spent = 0.0
        for k in range(hours):
            day = _day(start + k * 3600)
            if day not in days:
                continue
            cost = eur_h if cap is None else min(eur_h, max(0.0, cap - spent))
            days[day] += cost
            spent += cost
    if fixed and fixed.get("eur_h"):
        start = max(first, fixed["created"])
        charge(start, billed_hours(start, now), fixed["eur_h"], cap=fixed.get("eur_month"))
    return [{"day": k, "eur": round(v, 4)} for k, v in sorted(days.items())]


def permanent_slots(ci_busy):
    """Card del nodo permanente: poche mentre la CI usa il server, tutte quando è ferma."""
    return PERMANENT_SLOTS_CI if ci_busy > 0 else PERMANENT_SLOTS_IDLE


def selftest():
    assert billed_hours(0, 20 * 60) == 1 and billed_hours(0, 61 * 60) == 2
    assert permanent_slots(0) == PERMANENT_SLOTS_IDLE and permanent_slots(3) == PERMANENT_SLOTS_CI, "permanent node slots: CI-busy vs idle"
    t0 = time.mktime((2026, 11, 3, 10, 0, 0, 0, 0, -1))
    sd = spend_daily({"created": t0, "eur_h": 0.0}, t0 + 5 * 86400)
    assert sd[0]["day"].endswith("-01") and sd[0]["eur"] == 0 and len(sd) == 8, "dal primo del mese a oggi"
    sd2 = spend_daily({"created": t0, "eur_h": 0.5}, t0 + 90 * 60)
    assert next(x for x in sd2 if x["day"].endswith("-03"))["eur"] == 1.0, "90 minuti = 2 ore pagate"
    fx = spend_daily({"created": t0 - 86400, "eur_h": 1.0, "eur_month": 30.0}, t0 + 3 * 86400)
    assert round(sum(x["eur"] for x in fx), 2) == 30.0, "il nodo fisso si ferma al prezzo mensile"
    print("selftest ok")


