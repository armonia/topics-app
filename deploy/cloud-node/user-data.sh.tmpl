#!/bin/bash
# Ricetta unica di un nodo cloud di Topics (cloud-nodes, Fase 2).
# Gli strumenti vengono da deploy/node-tools.txt (lo stesso elenco del PC e di
# offload-hetzner): node-pool li sostituisce in @APT@ e @NPM@. Nessun segreto qui dentro:
# Hetzner serve user_data alla VM per tutta la sua vita.
set -u
export DEBIAN_FRONTEND=noninteractive
# sshd: keys only, and dead sessions free the tunnel's reverse ports within ~45 s.
# Without the client-alive drop-in a dead client session keeps -R 127.0.0.1:3301 bound
# and every new tunnel dies on ExitOnForwardFailure.
mkdir -p /etc/ssh/sshd_config.d
printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' > /etc/ssh/sshd_config.d/10-keys-only.conf
printf 'ClientAliveInterval 15\nClientAliveCountMax 3\n' > /etc/ssh/sshd_config.d/20-client-alive.conf
sshd -t && systemctl reload ssh
# logind guard: after PID 1 reconnects to the bus logind stops hearing that session scopes ended,
# and every ssh logout piles up as "closing" until SessionsMax refuses logins (card e809a470).
cat > /usr/local/sbin/logind-stale-sessions <<'EOS'
@LOGIND_GUARD@
EOS
chmod 755 /usr/local/sbin/logind-stale-sessions
printf '[Unit]\nDescription=Restart logind when closed ssh sessions are never released\n[Service]\nType=oneshot\nExecStart=/usr/local/sbin/logind-stale-sessions --heal\n' > /etc/systemd/system/logind-stale-sessions.service
printf '[Unit]\nDescription=Check for logind sessions stuck in closing\n[Timer]\nOnBootSec=10min\nOnUnitActiveSec=5min\n[Install]\nWantedBy=timers.target\n' > /etc/systemd/system/logind-stale-sessions.timer
systemctl daemon-reload && systemctl enable --now logind-stale-sessions.timer
apt-get update -qq
apt-get install -y -qq @APT@ lsof curl ca-certificates
# node con la major del Mac, come offload-hetzner
b=https://nodejs.org/dist/latest-v@NODE_MAJOR@.x
f=$(curl -fsSL $b/SHASUMS256.txt | awk '/linux-x64.tar.xz/{print $2}')
curl -fsSL $b/$f | tar -xJ -C /usr/local --strip-components=1
npm install -g --silent @NPM@ || true
# WebKit's OS libs (the preview screenshot's browser, see preview-browser.ts):
# without this a card dispatched here never gets a live screenshot, it just
# fails silently and the card sits without evidence. Same version pinned in
# server/lib/playwright-loader.ts's PLAYWRIGHT_CORE_VERSION; bump together.
npx -y "playwright@1.59.1" install-deps webkit >/var/log/topics-pw-deps.log 2>&1 || true
id topics >/dev/null 2>&1 || useradd -m -s /bin/bash topics
loginctl enable-linger topics
cat > /home/topics/setup.sh <<'EOS'
set -ex
cd ~
# No global git identity here: a card's project gets ITS OWN checkout's identity, set per run
# (node-pool's `sync_repo`) from the Mac's `git config`. A machine-wide one would be wrong the
# moment two projects with different identities ran on the same node, and stale the moment a
# snapshot outlived the Mac config it was built from.
git clone -q https://github.com/armonia/topics-app topics-app
cd topics-app && git checkout -q @COMMIT@
bash scripts/install-bun.sh
export PATH="$HOME/.topics/bun/$(tr -d '[:space:]' < .bun-version):$PATH"
bun install
npm rebuild node-pty || true
bun run scripts/fix-node-pty-exec-bit.ts || true
# WebKit's own binary (the OS libs went in above, as root): downloaded into
# this user's cache, where preview-browser.ts's webkit.launch() finds it.
npx -y "playwright@1.59.1" install webkit || true
mkdir -p ~/repos ~/.claude
EOS
chown topics:topics /home/topics/setup.sh
su - topics -c "bash /home/topics/setup.sh" > /var/log/topics-setup.log 2>&1
cat > /etc/systemd/system/topics.service <<'EOS'
[Unit]
Description=Topics node
After=network-online.target
Wants=network-online.target
[Service]
User=topics
WorkingDirectory=/home/topics/topics-app
Environment=HOME=/home/topics
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NO_TLS=1
# only the Mac reaches the node, through the ssh tunnel: nothing on the public address
Environment=SERVER_HOST=127.0.0.1
Environment=TOPICS_TUNNEL_PORT=3341
Environment=TOPICS_SERVER_WATCH=0
Environment=TOPICS_AI_BRIDGE=1
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/bin/bash scripts/start-prod.sh
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=on-failure
[Install]
WantedBy=multi-user.target
EOS
systemctl daemon-reload
systemctl enable --now topics.service
touch /var/lib/topics-node-ready
