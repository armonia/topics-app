---
/**
 * The icon set, in one place.
 *
 * It used to be pasted into each page: 26 symbols in the home page and 1 in the
 * changelog, which is how two pages end up drawing the same GitHub mark two
 * different ways. One file, included by the layout, and a page cannot be
 * missing a glyph it references.
 *
 * The grid, which is what makes a set look drawn rather than collected:
 *   · 24×24 viewBox, artwork inset to 3px on every side (an 18px optical body)
 *   · stroke 1.5, round caps and joins, no fill unless the mark is a logo
 *   · rectangles at r=2.5, circles at r=2.3 for nodes
 *   · every glyph reads at 17px, which is the size the page renders them at
 *
 * Stroke came down from 1.7 to 1.5. At 17px that is the difference between a
 * mark that reads as an app icon and one that reads as a diagram, and a diagram
 * is what these are: the terminal glyph is a prompt, the agents glyph is a
 * fleet graph, the worktree glyph is a branch that forks and does not rejoin.
 *
 * Filled marks (GitHub, the OS logos, the star, the play triangle) opt out with
 * .ic--fill because a logo drawn as an outline is not that logo.
 */
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    {/* ── Product concepts. Each of these is a schematic of the thing it names,
         not a picture of it. ─────────────────────────────────────────────── */}

    {/* A topic: a stack of layers, because a topic is a conversation with a
         workspace under it. */}
    <symbol id="ic-topics" viewBox="0 0 24 24"><path d="M12 3.4l8.2 4.2-8.2 4.2-8.2-4.2z"/><path d="M3.8 12.2l8.2 4.2 8.2-4.2"/><path d="M3.8 16.6l8.2 4.2 8.2-4.2"/></symbol>

    {/* A terminal: the frame and a prompt. The caret is the whole point, so it
         is the only thing inside. */}
    <symbol id="ic-terminal" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M7.4 9.8l2.6 2.4-2.6 2.4"/><path d="M12.8 14.6h4"/></symbol>

    {/* A browser: frame, chrome bar, two dots. */}
    <symbol id="ic-browser" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M3 9.2h18"/><circle cx="6.4" cy="6.85" r=".7" fill="currentColor" stroke="none"/><circle cx="8.8" cy="6.85" r=".7" fill="currentColor" stroke="none"/></symbol>

    {/* A split: one frame divided, and the divider carries a handle. */}
    <symbol id="ic-split" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M12.2 4.5v15"/><path d="M12.2 12H21"/></symbol>

    {/* Floating splits: four detached cards, gaps instead of hairlines. */}
    <symbol id="ic-float" viewBox="0 0 24 24"><rect x="3" y="4.6" width="8.2" height="6.8" rx="1.7"/><rect x="12.8" y="4.6" width="8.2" height="6.8" rx="1.7"/><rect x="3" y="12.6" width="8.2" height="6.8" rx="1.7"/><rect x="12.8" y="12.6" width="8.2" height="6.8" rx="1.7"/></symbol>

    {/* A board: three columns, and one card sitting in the middle one, because
         a board without a card on it is just a grid. */}
    <symbol id="ic-board" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M9 4.5v15M15 4.5v15"/><rect x="10.3" y="8.2" width="3.4" height="3" rx=".9" fill="currentColor" stroke="none"/></symbol>

    {/* A fleet: one lead node wired to three workers. Not a gear, not a robot
         head — the shape of the thing being described. */}
    <symbol id="ic-agents" viewBox="0 0 24 24"><circle cx="12" cy="5.2" r="2.3"/><circle cx="5.3" cy="17.6" r="2.3"/><circle cx="18.7" cy="17.6" r="2.3"/><circle cx="12" cy="13.9" r="1.8"/><path d="M12 7.5v4.6M10.5 15.1l-3.2 1.5M13.5 15.1l3.2 1.5"/></symbol>

    {/* A worktree: a branch that forks and does NOT rejoin, which is exactly
         what an isolated checkout is and exactly what distinguishes it from the
         merge glyph below it. */}
    <symbol id="ic-git" viewBox="0 0 24 24"><circle cx="6.6" cy="6.3" r="2.3"/><circle cx="6.6" cy="17.7" r="2.3"/><circle cx="17.4" cy="12" r="2.3"/><path d="M6.6 8.6v6.8"/><path d="M8.9 6.3h3.9a2.2 2.2 0 0 1 2.2 2.2v1.3"/></symbol>

    {/* A chart: axes and three bars, ascending. */}
    <symbol id="ic-chart" viewBox="0 0 24 24"><path d="M4 4.6v14.8h16"/><path d="M7.8 16.2v-3.2M12 16.2V9.4M16.2 16.2v-5.2"/></symbol>

    {/* Files: a folder with a tab. */}
    <symbol id="ic-files" viewBox="0 0 24 24"><path d="M3.6 6.8a1.6 1.6 0 0 1 1.6-1.6h3.3l1.7 2.2h8.2a1.6 1.6 0 0 1 1.6 1.6v8.4a1.6 1.6 0 0 1-1.6 1.6H5.2a1.6 1.6 0 0 1-1.6-1.6z"/></symbol>

    <symbol id="ic-cloud" viewBox="0 0 24 24"><path d="M7.5 18.2h9.3a3.85 3.85 0 0 0 .5-7.66A5.85 5.85 0 0 0 6.4 11.2a3.55 3.55 0 0 0 1.1 7z"/></symbol>

    {/* ── Interface. ────────────────────────────────────────────────────── */}

    <symbol id="ic-open" viewBox="0 0 24 24"><path d="M9.3 7.9L4.6 12l4.7 4.1"/><path d="M14.7 7.9L19.4 12l-4.7 4.1"/></symbol>
    <symbol id="ic-check" viewBox="0 0 24 24"><path d="M5 12.3l4.6 4.6L19 6.9"/></symbol>
    <symbol id="ic-lock" viewBox="0 0 24 24"><rect x="4.8" y="10.4" width="14.4" height="9" rx="2.2"/><path d="M8.3 10.4V8.1a3.7 3.7 0 0 1 7.4 0v2.3"/></symbol>
    <symbol id="ic-key" viewBox="0 0 24 24"><circle cx="7.7" cy="12" r="3.3"/><path d="M11 12h9.2"/><path d="M17.2 12v3.1M20.2 12v2.3"/></symbol>
    <symbol id="ic-warn" viewBox="0 0 24 24"><path d="M12 4.4l8.8 15H3.2z"/><path d="M12 10.2v4.1"/><circle cx="12" cy="16.9" r=".85" fill="currentColor" stroke="none"/></symbol>
    <symbol id="ic-expand" viewBox="0 0 24 24"><path d="M9.4 4.8H4.8v4.6M14.6 4.8h4.6v4.6M9.4 19.2H4.8v-4.6M14.6 19.2h4.6v-4.6"/></symbol>
    <symbol id="ic-collapse" viewBox="0 0 24 24"><path d="M4.8 9.4h4.6V4.8M19.2 9.4h-4.6V4.8M4.8 14.6h4.6v4.6M19.2 14.6h-4.6v4.6"/></symbol>
    <symbol id="ic-cursor" viewBox="0 0 24 24"><path d="M5.6 3.8l12.9 6.7-5.6 1.5-1.5 5.6z"/><path d="M13.3 13.5l4.5 5.2"/></symbol>
    <symbol id="ic-dl" viewBox="0 0 24 24"><path d="M12 3.8v11.4M8.3 11.5L12 15.2l3.7-3.7M5 19.8h14"/></symbol>
    <symbol id="ic-arrow" viewBox="0 0 24 24"><path d="M4.8 12h14.4"/><path d="M14 6.8L19.2 12 14 17.2"/></symbol>
    <symbol id="ic-play" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M8.6 6v12L18 12z"/></symbol>
    <symbol id="ic-star" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M12 .6l3.668 7.43 8.2 1.193-5.934 5.784 1.401 8.168L12 18.9l-7.335 3.866 1.401-8.168L.132 9.223l8.2-1.193z"/></symbol>

    {/* ── Logos. Filled, because an outlined logo is a different logo. ───── */}

    <symbol id="ic-gh" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.72c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></symbol>
    <symbol id="os-apple" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M17.05 12.04c-.03-2.85 2.33-4.22 2.44-4.28-1.33-1.95-3.4-2.22-4.13-2.25-1.76-.18-3.43 1.04-4.32 1.04-.89 0-2.26-1.02-3.72-.99-1.91.03-3.68 1.11-4.66 2.82-1.99 3.45-.51 8.56 1.43 11.36.95 1.37 2.08 2.91 3.56 2.86 1.43-.06 1.97-.92 3.7-.92 1.72 0 2.21.92 3.72.89 1.54-.03 2.51-1.4 3.45-2.78 1.09-1.59 1.54-3.13 1.56-3.21-.03-.01-2.99-1.15-3.02-4.55zM14.2 4.38c.79-.96 1.32-2.29 1.18-3.62-1.14.05-2.52.76-3.33 1.72-.73.85-1.37 2.2-1.2 3.5 1.27.1 2.57-.65 3.35-1.6z"/></symbol>
    <symbol id="os-windows" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M3 5.5l7.6-1.04v7.04H3zM11.4 4.34L21 3v9.04h-9.6zM3 12.5h7.6v7.04L3 18.5zM11.4 12.5H21V21l-9.6-1.34z"/></symbol>
    {/* The penguin's counters are knocked out in the PAGE colour, not in a
         hard-coded near-black: the glyph sits on a light tile with ink as its
         body, so dark counters inside a dark silhouette disappear. */}
    <symbol id="os-linux" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M12 2.2c-2.05 0-3.3 1.7-3.3 3.8 0 .95.18 1.55.18 2.35 0 1.05-1.4 2.05-2.1 3.55-.78 1.62-1.55 3.4-1.55 4.95 0 1 .62 1.6 1.55 1.6.6 0 1 .5 1.7.92.66.42 1.45.83 3.02.83s2.36-.41 3.02-.83c.7-.42 1.1-.92 1.7-.92.93 0 1.55-.6 1.55-1.6 0-1.55-.77-3.33-1.55-4.95-.7-1.5-2.1-2.5-2.1-3.55 0-.8.18-1.4.18-2.35 0-2.1-1.25-3.8-3.3-3.8z"/><circle cx="10.4" cy="7.1" r=".95" fill="var(--p-0)" stroke="none"/><circle cx="13.6" cy="7.1" r=".95" fill="var(--p-0)" stroke="none"/><path d="M11 8.7h2l-1 1.5z" fill="var(--p-0)" stroke="none"/></symbol>
  </defs>
</svg>
