---
/**
 * Three schematics for the three ideas the whole product rests on.
 *
 * Not icons. An icon at 17px can say "terminal"; it cannot say "a topic is one
 * conversation with four surfaces attached to it", and that sentence is the
 * thing a visitor has to understand before any screenshot below means anything.
 * These are diagrams: they carry structure, they are read rather than
 * recognised, and they are drawn at the size they are read at.
 *
 * Rules they share with the icon set, so the page looks drawn by one hand:
 *   · 1.5 stroke, round caps and joins
 *   · rectangles at r=3, nodes at r=3.5
 *   · every colour is a semantic token, so they follow the palette rather than
 *     pinning it
 *
 * Colour does one job here and only one: the accent marks the ACTIVE element in
 * each diagram (the topic, the focused pane, the card in flight). Everything
 * else is rule and ink. A schematic where four things are coloured has stopped
 * pointing at anything.
 */
export interface Props {
  /** Which of the three. */
  kind: 'topic' | 'panes' | 'board';
}
const { kind } = Astro.props;

const LABEL: Record<Props['kind'], string> = {
  topic: 'Diagram: one topic in the centre, joined to four surfaces around it — a chat, a terminal, a browser and the project files.',
  panes: 'Diagram: a window holding a tab strip and three panes, one wide on the left and two stacked on the right, with the left pane focused.',
  board: 'Diagram: four board columns with a card moving left to right, and a diff leaving the last column.',
};
---

<svg class="mdiag" viewBox="0 0 220 132" role="img" aria-label={LABEL[kind]} fill="none">
  {kind === 'topic' && (
    <g>
      {/* Spokes first, so the nodes sit on top of them. */}
      <g class="mdiag__line">
        <path d="M110 66 L52 32" /><path d="M110 66 L168 32" />
        <path d="M110 66 L52 100" /><path d="M110 66 L168 100" />
      </g>
      {/* The four surfaces. Each is the shape of what it is, not a label. */}
      <g class="mdiag__box">
        <rect x="22" y="18" width="60" height="28" rx="3" />
        <path d="M32 28h22M32 36h30" class="mdiag__hint" />
      </g>
      <g class="mdiag__box">
        <rect x="138" y="18" width="60" height="28" rx="3" />
        <path d="M148 27l6 5-6 5M158 37h12" class="mdiag__hint" />
      </g>
      <g class="mdiag__box">
        <rect x="22" y="86" width="60" height="28" rx="3" />
        <path d="M22 95h60" class="mdiag__hint" />
      </g>
      <g class="mdiag__box">
        <rect x="138" y="86" width="60" height="28" rx="3" />
        <path d="M148 96h14l4 5h18" class="mdiag__hint" />
      </g>
      {/* The topic itself: the only filled thing in the frame. */}
      <circle class="mdiag__node" cx="110" cy="66" r="15" />
      <path class="mdiag__nodeMark" d="M110 59l7 3.6-7 3.6-7-3.6z M103 67.4l7 3.6 7-3.6" />
    </g>
  )}

  {kind === 'panes' && (
    <g>
      <rect class="mdiag__box" x="14" y="16" width="192" height="102" rx="4" />
      <path class="mdiag__line" d="M14 34h192" />
      {/* Tab strip: three tabs, the first one live. */}
      <rect class="mdiag__tabOn" x="22" y="21" width="34" height="9" rx="2" />
      <rect class="mdiag__tab" x="60" y="21" width="34" height="9" rx="2" />
      <rect class="mdiag__tab" x="98" y="21" width="24" height="9" rx="2" />
      {/* Three panes, gaps rather than hairlines, the left one focused. */}
      <rect class="mdiag__paneOn" x="22" y="42" width="86" height="68" rx="3" />
      <rect class="mdiag__pane" x="116" y="42" width="82" height="31" rx="3" />
      <rect class="mdiag__pane" x="116" y="79" width="82" height="31" rx="3" />
      <path class="mdiag__hint" d="M32 56h48M32 66h62M32 76h38" />
    </g>
  )}

  {kind === 'board' && (
    <g>
      {[14, 66, 118, 170].map((x) => <rect class="mdiag__col" x={x} y="20" width="36" height="94" rx="3" />)}
      {/* The card, and its trail: three positions of one thing, not three
          things. The trail is what makes it read as movement. */}
      <rect class="mdiag__ghost" x="20" y="28" width="24" height="14" rx="2" />
      <rect class="mdiag__ghost" x="72" y="28" width="24" height="14" rx="2" />
      <rect class="mdiag__card" x="124" y="28" width="24" height="14" rx="2" />
      <path class="mdiag__arrow" d="M50 35h10M102 35h10M154 35h10" />
      {/* What comes back out: a diff, added and removed. */}
      <path class="mdiag__add" d="M178 56h20M178 66h14" />
      <path class="mdiag__del" d="M178 76h17" />
    </g>
  )}
</svg>

<style>
  .mdiag { display: block; width: 100%; max-width: 240px; height: auto; margin-bottom: 18px; }
  .mdiag g, .mdiag path, .mdiag rect, .mdiag circle {
    stroke-linecap: round; stroke-linejoin: round;
  }
  .mdiag__box, .mdiag__box rect, .mdiag__pane, .mdiag__col, .mdiag__tab {
    stroke: var(--rule-2); stroke-width: 1.5; fill: none;
  }
  .mdiag__line, .mdiag__line path, .mdiag__arrow { stroke: var(--rule-2); stroke-width: 1.5; }
  /* The quiet interior marks: text lines, a prompt, a folder tab. They carry no
     information beyond "this surface has content in it", so they are the
     lightest thing in the frame. */
  .mdiag__hint { stroke: var(--rule-3); stroke-width: 1.5; }
  .mdiag__node { fill: var(--accent); stroke: none; }
  .mdiag__nodeMark { stroke: var(--p-0); stroke-width: 1.4; fill: none; }
  .mdiag__tabOn { fill: var(--accent); stroke: none; }
  .mdiag__paneOn { stroke: var(--accent); stroke-width: 1.5; fill: var(--accent-wash); }
  .mdiag__card { fill: var(--accent); stroke: none; }
  /* Earlier positions of the same card. Not a third and fourth card. */
  .mdiag__ghost { fill: var(--rule); stroke: none; }
  .mdiag__add { stroke: var(--good); stroke-width: 1.5; }
  .mdiag__del { stroke: var(--accent-ink); stroke-width: 1.5; }
</style>
