---
/**
 * The home page, second draft — the "five acts" structure.
 *
 * Not linked from anywhere and marked noindex: this is the page to look at
 * beside the live one, not a replacement for it yet. Everything it needs that
 * the live page also uses is imported, never copied, so the two cannot drift on
 * the facts while they disagree on the shape.
 *
 * What changed, and the measurement behind each:
 *
 * • The live page is 16,141px against Linear's 10,898, and a single block
 *   (#features, 5,300px) is 33% of it: six stories, six pictures and 33 bullets
 *   with nothing to say which one matters. Here that block is five ACTS of
 *   ~1,100px, one idea each, in the order you meet them using the product.
 * • Every act headline starts with a verb. On the live page two of ten do.
 * • Each act is anchored by a SCENE rather than a photograph of the window: an
 *   actor in the foreground at 1:1 with real 13px text, the context behind it
 *   dimmed. Linear does this and it is why their surfaces read at any width;
 *   a 1,240px window photographed into a 640px column can only shrink.
 * • The product now sits IN the hero, cropped by the fold, instead of starting
 *   516px down behind a poster.
 * • The live page goes 11,003px between the hero CTA and the next one in the
 *   content. Here there is one roughly every 2,400px.
 */
import Base from '../layouts/Base.astro';
import IconSprite from '../components/IconSprite.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ChangelogList from '../components/ChangelogList.astro';
import { homeTools, READ_ON } from '../data/compare';
import { repoStats, longDate } from '../lib/repo-stats';

const stats = repoStats();
---

<Base
  title="Topics · four agents, one repo, nobody collides"
  description="A desktop workspace for Claude Code, Codex, Gemini CLI and any other terminal agent. Every task gets its own git worktree, so several agents work the same repository at once."
  path="/v3"
  htmlAttrs={{ 'data-v3': 'true' }}
  bodyClass="v3"
  {/* The ground, declared once for the whole document. It sits on <body> and
      not on <html> because the ground's token block resolves --accent from
      --brand-on-dark, which `body.v3` declares: a custom property whose var()
      points at an ancestor that does not define it is invalid at computed-value
      time and quietly becomes nothing. That is not theoretical — with the
      attribute on <html>, --accent computed to the empty string and every act
      glyph fell back to inheriting --ink. */}
  bodyAttrs={{ 'data-ground': 'dark' }}
  themeColor="#0a0d14"
  fontshare="https://api.fontshare.com/v2/css?f%5B%5D=switzer@400,500,600,700&display=swap"
>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  {/* In the head, and discovered with the other stylesheets rather than after
     the whole body has been parsed: a render-blocking sheet linked in the body
     cost 156ms of LCP against the same page without it. */}
  <link slot="head" rel="stylesheet" href="/v3.css" />
  <IconSprite />

  {/* ── THE FIELD ──────────────────────────────────────────────────────────
       One fixed layer behind the whole document, and inside it one WebGL
       surface: a lit, domain-warped height field whose flow, key light, hue and
       drift are all functions of how far down the page you are. The full note is
       at the top of `src/scripts/fluid.ts`.

       The two divs under the canvas are not decoration and not a placeholder —
       they are the complete picture for a browser that will not give us a
       context. The script adds `has-field` to <body> only after the first
       successful draw, and that is what takes the fallback away.

       Nothing here is in the flow, so none of it can shift anything. */}
  <div class="field" aria-hidden="true">
    <canvas id="field"></canvas>
    <div class="field__aurora"></div>
    <div class="field__weave"></div>
    <div class="field__grain"></div>
  </div>

  <header class="capsule" id="capsule">
    <div class="capsule__in">
      {/* THE SHIPPED ICON, not a drawing of one. A previous pass replaced this
          with an invented vector mark on the argument that two chat bubbles are
          the wrong metaphor for a workspace. That may even be true, but a
          landing page is not where a product renames itself: the icon in the
          dock, in the tab, on the releases page and in every screenshot on this
          page is the blue tile, and a header that shows something else is a
          header showing the wrong product. Raster on purpose — it is the exact
          file the app ships, at 64px for a 26px slot. */}
      <a class="capsule__brand" href="/" aria-label="Topics home">
        <img class="mark" src="/icon-64.png" alt="" width="26" height="26" decoding="async" />
        <span>Topics</span>
      </a>
      <nav class="capsule__links" aria-label="Primary">
        <a href="#atto-1">Product</a>
        <a href="/wiki">Docs</a>
        <a href="/compare/claude-code-guis">Compare</a>
        <a href="#pricing">Pricing</a>
        <a href="/changelog">Changelog</a>
      </nav>
      <div class="capsule__cta">
        <a class="btn btn--ghost btn--sm" href="https://github.com/armonia/topics-app" rel="noopener" target="_blank" aria-label="Topics on GitHub">
          <svg class="ic ic--fill" aria-hidden="true"><use href="#ic-gh"/></svg>
          <span class="capsule__ghlabel">GitHub</span>
        </a>
        <a class="btn btn--primary btn--sm halo" href="#download">Download</a>
      </div>
    </div>
  </header>

  <main id="top">

    {/* ── HERO ───────────────────────────────────────────────────────────────
         The product is in here, cropped by the bottom of the screen. On the
         live page the frame starts at y 516 with a poster over it, which is
         1,211px between the claim and the only thing that proves it. */}
    <section class="hero">
      <div class="hero__in">
        <p class="hero__badge">
          <span class="dot-live"></span>
          v{stats.version} · macOS, Windows, Linux · MIT
        </p>
        <h1 class="hero__title" id="heroTitle">
          Four agents, one repo,<br /><span class="dim">nobody collides.</span>
        </h1>
        <p class="hero__sub">
          A desktop workspace for <span class="slot" id="agentSlot">Claude&nbsp;Code</span>.
          Every task gets its own git worktree, so several agents can be mid-edit on the
          same repository without touching each other's files.
        </p>
        {/* The proof used to be 1,211px below the claim. It is the same
             sentence, so it goes in the same breath. */}
        {/* TWO, AND BOTH ARE ABOUT THE READER. It had four, and the first two
             were "commits" and "in 7 days" — activity theatre. A commit count is
             a fact about how busy I have been, not about whether this is worth
             installing, and a landing page that leads with it is asking to be
             admired rather than used. Releases says it ships; telemetry: none is
             a promise about what happens on the visitor's machine. */}
        {/* AND IT SITS ABOVE THE BUTTONS, WHICH IS A LIGHTING DECISION BEFORE IT
             IS A RHETORICAL ONE. The light in this hero rises from the bottom,
             and the reference's hero puts every word it has in the black half
             and its photograph in the lit one. This row is 12.5px type: measured
             with the ceiling driven to 0.40, it was the ONLY thing on the whole
             first screen that failed — the two buttons under it never did,
             because a button carries its own opaque fill and does not read
             against the field at all. So the one text that cannot live in the
             light moves out of it, and what stays down there is the two controls
             and the app.
             It reads better in that order anyway: claim, proof, act. */}
        {/* "releases" used to be the first of the two, counted up from a
             literal 78 that nobody could have refuted from this page. It is
             gone rather than corrected: no file in the tree carries a truthful
             release count, so any number here was a number that could rot in
             silence. Price says the same thing to the same reader and is
             checkable in one click on the pricing section. */}
        <dl class="hero__proof">
          <div><dt>price</dt><dd class="is-word">&euro;0</dd></div>
          <div><dt>telemetry</dt><dd class="is-word">none</dd></div>
        </dl>

        <div class="hero__actions">
          <a class="btn btn--primary btn--lg halo" id="primaryDownload" href="https://github.com/armonia/topics-app/releases/latest" rel="noopener" target="_blank">
            <svg class="ic"><use href="#ic-dl"/></svg>
            <span id="primaryDownloadLabel">Download</span>
          </a>
          {/* The old second button said "See it working" and scrolled to a
              poster with a play triangle on it. The thing it pointed at is now
              directly below, already running, so a button that points at it is
              a button that points at itself. */}
          <a class="btn btn--glass btn--lg" href="#model">
            <span>How it works</span>
            <svg class="ic"><use href="#ic-arrow"/></svg>
          </a>
        </div>
      </div>

      {/* ── THE ONE DEMO ────────────────────────────────────────────────────
           The real client, on sample data, running from the moment the page
           settles. There is no second demo and no play button anywhere on this
           page, and both of those are deliberate.

           WHAT WAS HERE BEFORE. A photograph of the window in the hero, and
           then 1,100px lower a SECOND window — the live one — behind a poster
           with a play triangle on it. Two pictures of the same product, one of
           them fake, and the real one gated behind a decision the visitor has
           no reason to make yet. A play button on a product demo asks someone
           who has read one sentence to commit to watching something.

           So the poster stays and the button goes. `home.ts` sets `src` on the
           next idle callback rather than on a click: the page paints first, the
           449KB client boots a moment later, and the poster underneath is
           replaced by the thing it is a picture of. Nobody presses anything.

           The frame is NOT cropped by the fold any more. A crop is the right
           gesture for a photograph — it says "there is more, scroll" — and the
           exact wrong one for something you can click, because the half you cut
           off is the half that was interactive. */}
      <div class="hero__stage showcase">
        <div class="showcase__frame">
          <iframe class="window-real" id="demoFrame" data-src="/app/index.html"
                  title="Interactive Topics demo: the real app on sample data. Pick a chapter below, or click in and drive it yourself."></iframe>
          <div class="showcase__poster" id="demoPoster" aria-hidden="true">
            <img src="/img/demo-poster.webp" alt="" width="2560" height="1440"
                 fetchpriority="high" decoding="async" />
          </div>
          {/* An iframe eats the wheel, so without this a visitor scrolling past
              the demo gets trapped in the app's own scroll containers. It is a
              layer in THIS document; one click hands the pointer over. */}
          <button class="shield" id="demoShield" type="button" aria-label="Take control of the demo">
            <span class="shield__hint"><svg class="ic" aria-hidden="true"><use href="#ic-cursor"/></svg>Click to take control</span>
          </button>
          <button class="expand" id="demoExpand" type="button" aria-expanded="false" aria-label="Expand the demo to fill the window">
            <svg class="ic" aria-hidden="true"><use href="#ic-expand"/></svg>
            <span class="expand__label">Expand</span>
          </button>
        </div>
      </div>

      {/* THE FLOAT. The headline makes a claim — four agents, one repo, nobody
           collides — and the screenshot behind it cannot prove it: at hero size
           you cannot read a branch name off a photograph. So the claim is spelled
           out in front, in the product's own card, at 1:1, in live DOM.

           It is a sibling of the stage rather than a child because the stage is
           masked to fade into the fold, and a card that dissolves at the bottom
           reads as a rendering fault. Absolutely positioned, so it is outside
           the flow and cannot shift the page. */}
      <aside class="hero__float">
        <div class="hf__bar">
          <span class="hf__dot"></span>
          <span class="hf__repo">acme-web</span>
          <span class="hf__meta">4 worktrees · 1 checkout</span>
        </div>
        <ul class="hf__rows">
          <li><span class="pip pip--work"></span><b>Opus 5</b><code>topics/offline-sync</code><span class="hf__st">editing</span></li>
          <li><span class="pip pip--work"></span><b>Codex</b><code>topics/webhook-signature</code><span class="hf__st">editing</span></li>
          <li><span class="pip pip--rev"></span><b>Gemini</b><code>topics/context-sources</code><span class="hf__st">review</span></li>
          <li><span class="pip pip--go"></span><b>Opus 5</b><code>topics/release-signing</code><span class="hf__st">landed</span></li>
        </ul>
        <p class="hf__foot"><svg class="ic"><use href="#ic-check"/></svg>No shared working tree. No stashing between them.</p>
      </aside>

      {/* The chapter rail. Each button asks the running app to switch GROUP —
           a real tab click inside the real client, not a slideshow — so the
           demo above is also the table of contents for the page below it. */}
      <div class="chapters" role="group" aria-label="Demo chapters" id="chapters">
        <button class="chapter" data-scene="terminals" type="button"><svg class="ic"><use href="#ic-terminal"/></svg><span class="chapter__name">Live terminals</span><span class="chapter__hint">Two Claude Code sessions, mid-run</span></button>
        <button class="chapter" data-scene="board" type="button"><svg class="ic"><use href="#ic-board"/></svg><span class="chapter__name">Agent board</span><span class="chapter__hint">Queued, working, waiting on you</span></button>
        <button class="chapter" data-scene="fleet" type="button"><svg class="ic"><use href="#ic-agents"/></svg><span class="chapter__name">Its own group</span><span class="chapter__hint">A group wraps its tabs</span></button>
        <button class="chapter" data-scene="dashboard" type="button"><svg class="ic"><use href="#ic-chart"/></svg><span class="chapter__name">Dashboard</span><span class="chapter__hint">Throughput and spend</span></button>
        <button class="chapter" data-scene="browser" type="button"><svg class="ic"><use href="#ic-browser"/></svg><span class="chapter__name">Browser pane</span><span class="chapter__hint">Your localhost, inside the window</span></button>
        <button class="chapter" data-scene="git" type="button"><svg class="ic"><use href="#ic-git"/></svg><span class="chapter__name">Git and diffs</span><span class="chapter__hint">Read the change before you take it</span></button>
        <button class="chapter" data-scene="files" type="button"><svg class="ic"><use href="#ic-files"/></svg><span class="chapter__name">Files</span><span class="chapter__hint">Explorer, editor, search</span></button>
        <button class="chapter" data-scene="workspace" type="button"><svg class="ic"><use href="#ic-split"/></svg><span class="chapter__name">Groups</span><span class="chapter__hint">Three projects, one group</span></button>
      </div>
      <p class="demo__foot"><span class="dot-live"></span><span id="demoStatus">The real application, on sample data. Not a video: click in and drive it.</span></p>
    </section>

    {/* ── THE MODEL ─────────────────────────────────────────────────────── */}
    <section class="model" id="model">
      <header class="shead">
        <p class="eyebrow">the whole idea</p>
        <h2>Three things, and you know the app.</h2>
        <p class="shead__lead">There is no new workflow to learn. The agents are the ones you already run, in a terminal, on your own account.</p>
      </header>
      <ol class="model__grid">
        <li class="model__step">
          <span class="model__n">01</span>
          <h3>A topic is a session with a workspace attached</h3>
          <p>One conversation, and the things it needs: a terminal, a branch, a browser, the files it touched. Close the app and it comes back the same, scrollback included.</p>
        </li>
        <li class="model__step">
          <span class="model__n">02</span>
          <h3>Panes and groups are the room it lives in</h3>
          <p>Split any pane, drag tabs between groups, keep three whole projects open beside each other. The layout persists, and syncs to your other machine.</p>
        </li>
        <li class="model__step">
          <span class="model__n">03</span>
          <h3>The board is where you hand work over</h3>
          <p>Write a task, an agent takes it in a <code>git worktree</code> of its own, and hands back a commit and evidence. You read the diff and decide.</p>
        </li>
      </ol>
    </section>

    {/* ══ ACT 1 ══ ISOLATION ═════════════════════════════════════════════ */}

    {/* ── BAND 2 · INK ───────────────────────────────────────────────────────
         The five acts, one continuous ink run of ~3,000px. The scenes stop
         being framed pictures here: on this ground the mock has no card, so the
         only card left in an act is the one the product itself draws. */}

    <section class="act" id="atto-1">
      <div class="act__body">
        <svg class="act__glyph" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#ac-isolation"/></svg>
        <p class="act__kicker"><span class="act__n">01</span> Isolation</p>
        <h2>Run four agents on one repository and watch none of them collide.</h2>
        <p class="act__lead">
          Each task is checked out into a <code>git worktree</code> of its own, on its own
          branch. Four agents can be mid-edit at the same time, in the same repository,
          and never see each other's uncommitted files.
        </p>
                <ol class="beats">
          <li><b>You write the task.</b> One card, in the project's own board.</li>
          <li><b>Topics cuts it a checkout.</b><code>git worktree add ../acme-web@release-signing -b topics/release-signing</code></li>
          <li><b>The agent works in there.</b> Its uncommitted edits are invisible to the other three, and to you. Nobody stashes anything.</li>
          <li><b>You keep working on main the whole time.</b> Four checkouts, one <code>.git</code>, one clone on disk.</li>
        </ol>
        <p class="act__also">Concurrency is sized to the machine, so eight agents do not thrash one laptop. A Claude Code session you started yourself, in your own terminal, shows up here too.</p>
      </div>
      <figure class="act__stage">
        <span class="scene__tag">acme-web · main</span>
        <div class="scene scene--worktrees">
          {/* The real window, at the state this act is about: the same client
               that is running in the hero, driven to this tab and captured.
               Nothing in this picture is drawn by hand. */}
          <img class="scene__shot" src="/img/act-worktrees.webp" width="1400" height="1054"
               loading="lazy" decoding="async" alt="The Git pane of the Topics window: the branch list on the left and the diff of the selected file beside it." />
        </div>
        <figcaption>Four worktrees open on the same repository. The one in front is the agent you are watching; the other three are working too, and cannot touch its files.</figcaption>
      </figure>
    </section>

    {/* ══ ACT 2 ══ DISPATCH ══════════════════════════════════════════════ */}
    <section class="act act--flip" id="atto-2">
      <div class="act__body">
        <svg class="act__glyph" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#ac-dispatch"/></svg>
        <p class="act__kicker"><span class="act__n">02</span> Dispatch</p>
        <h2>Hand a card to an agent and get a diff back.</h2>
        <p class="act__lead">
          A worktree per agent is not ours alone any more. What is still unusual is the
          board: the agent picks the card up itself, works it, and moves it to review with
          the evidence attached.
        </p>
                <ol class="beats">
          <li><b>The card moves itself.</b> An agent takes it from <span class="chip">todo</span>, works it, and puts it in <span class="chip">review</span>. You are not the dispatcher.</li>
          <li><b>It has to pass your checks first.</b> The commands you named for that board run in its worktree; a red one means it comes back to you and says so.</li>
          <li><b>It arrives with evidence.</b> A commit, a summary of what changed and why, and, for anything with behaviour, a clip of the thing running.</li>
          <li><b>You read the diff and decide.</b> Approving accepts the work. Landing it on main is a second, deliberate click.</li>
        </ol>
        <p class="act__also">Rejecting sends it back into the same worktree with your notes, so the agent picks up where it was rather than starting again. Night mode dispatches only while the machine is idle, and stops when you touch it.</p>
        <a class="act__cta btn btn--glass" href="#download"><span>Download Topics</span><svg class="ic"><use href="#ic-arrow"/></svg></a>
      </div>
      <figure class="act__stage">
        <span class="scene__tag">board · acme-web</span>
        <div class="scene scene--board">
          {/* The real window, at the state this act is about: the same client
               that is running in the hero, driven to this tab and captured.
               Nothing in this picture is drawn by hand. */}
          <img class="scene__shot" src="/img/act-board.webp" width="1400" height="1054"
               loading="lazy" decoding="async" alt="The board inside the Topics window: backlog, in progress, review and done, with agent cards in each column." />
        </div>
        <figcaption>The card an agent picked up, worked, and moved to review by itself. Approving accepts it; landing it into main is a second, separate click.</figcaption>
      </figure>
    </section>

    {/* ══ ACT 3 ══ THE WINDOW ════════════════════════════════════════════ */}
    <section class="act" id="atto-3">
      <div class="act__body">
        <svg class="act__glyph" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#ac-window"/></svg>
        <p class="act__kicker"><span class="act__n">03</span> The window</p>
        <h2>Keep the agent, the dev server and the page it renders in one window.</h2>
        <p class="act__lead">
          Every topic carries its own terminals, browser and files, and gets them back after
          a restart. Split any pane, drag a tab into another group, or move a whole group
          into a window of its own.
        </p>
                <ol class="beats">
          <li><b>A topic carries its own room.</b> Terminals, a browser, the files it touched, the layout you left them in.</li>
          <li><b>Shut the lid.</b> Reopen it and the session is still attached, scrollback included, at the line it was on.</li>
          <li><b>Split, drag, detach.</b> Any pane splits; any tab moves to another group; any group becomes its own window.</li>
          <li><b>Open the same project on the laptop.</b> The layout syncs and comes back in the shape you left it.</li>
        </ol>
        <p class="act__also">The browser is a real one, not an iframe: it runs your localhost, keeps its logins, and an agent can drive it and read back what it sees.</p>
      </div>
      <figure class="act__stage">
        <span class="scene__tag">group · Progetti</span>
        <div class="scene scene--window">
          {/* The real window, at the state this act is about: the same client
               that is running in the hero, driven to this tab and captured.
               Nothing in this picture is drawn by hand. */}
          <img class="scene__shot" src="/img/act-group.webp" width="1400" height="877"
               loading="lazy" decoding="async" alt="The Progetti group: three project windows tiled in one frame, each with its own Claude Code session." />
        </div>
        <figcaption>The tab itself says what its session is doing. A native notification arrives when one finishes, or gets stuck on a question.</figcaption>
      </figure>
    </section>

    {/* ══ ACT 4 ══ THE NUMBERS ═══════════════════════════════════════════ */}
    <section class="act act--flip" id="atto-4">
      <div class="act__body">
        <svg class="act__glyph" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#ac-numbers"/></svg>
        <p class="act__kicker"><span class="act__n">04</span> The numbers</p>
        <h2>See what the agents got through, and what the tokens cost.</h2>
        <p class="act__lead">
          Throughput, cycle time and spend over the window you pick, read from the same
          database the app writes. Plus the one number nobody else shows you: which tab is
          eating your RAM.
        </p>
                <ol class="beats">
          <li><b>What went through.</b> Tasks finished, time from review to landed, and how many are waiting on you right now.</li>
          <li><b>What it cost.</b> Tokens and money per day, per project, per model, read from the sessions themselves rather than estimated.</li>
          <li><b>What is filling the window.</b> The context inspector shows every source in the prompt, and lets you switch one off and watch the number fall.</li>
          <li><b>What the machine is doing.</b> Memory and CPU per pane, so a runaway terminal is a row and not a hunch.</li>
        </ol>
        <p class="act__also">Prompt caching marks the stable prefix of every conversation, which is most of what a long session was paying for twice.</p>
        <a class="act__cta btn btn--glass" href="#pricing"><span>What it costs</span><svg class="ic"><use href="#ic-arrow"/></svg></a>
      </div>
      <figure class="act__stage">
        <span class="scene__tag">dashboard · last 7 days</span>
        <div class="scene scene--kpi">
          {/* The real window, at the state this act is about: the same client
               that is running in the hero, driven to this tab and captured.
               Nothing in this picture is drawn by hand. */}
          <img class="scene__shot" src="/img/act-numbers.webp" width="1400" height="877"
               loading="lazy" decoding="async" alt="The Topics dashboard: tasks in flight, error rate, token spend for today and the week, and a throughput chart." />
        </div>
        <figcaption>The headline row at the size it is in the app. Every figure comes from the SQLite file on your disk, and the bill stays between you and your provider.</figcaption>
      </figure>
    </section>

    {/* ══ ACT 5 ══ OWNERSHIP ═════════════════════════════════════════════ */}
    <section class="act" id="atto-5">
      <div class="act__body">
        <svg class="act__glyph" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#ac-ownership"/></svg>
        <p class="act__kicker"><span class="act__n">05</span> Ownership</p>
        <h2>Point it at your own account, and keep the data on your disk.</h2>
        <p class="act__lead">
          Topics talks to Anthropic or OpenAI with your key, or through the CLI you are
          already signed in to. We are never in the path, so there is no bill from us and
          nothing of yours passing through anything of ours.
        </p>
                <ol class="beats">
          <li><b>Your account, your key.</b> Topics spawns the CLI you already use, signed in the way you already signed in. We are not a proxy and there is nothing to route through us.</li>
          <li><b>Your disk.</b> Conversations, layouts and boards are SQLite and files under your home directory. You can read them with <code>sqlite3</code>.</li>
          <li><b>No account and no telemetry.</b> Not a weak one, not an opt-out: there is no endpoint to send anything to.</li>
          <li><b>MIT.</b> Read it, fork it, ship it, sell it.</li>
        </ol>
