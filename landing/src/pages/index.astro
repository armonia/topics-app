      <symbol id="os-windows" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M3 5.5l7.6-1.04v7.04H3zM11.4 4.34L21 3v9.04h-9.6zM3 12.5h7.6v7.04L3 18.5zM11.4 12.5H21V21l-9.6-1.34z"/></symbol>
      <!-- The penguin's eyes and beak are knocked out in PAPER, not in the old
           page's near-black: the icon now sits on a light tile with ink as its
           body colour, so dark counters inside a dark silhouette vanish. -->
      <symbol id="os-linux" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M12 2.2c-2.05 0-3.3 1.7-3.3 3.8 0 .95.18 1.55.18 2.35 0 1.05-1.4 2.05-2.1 3.55-.78 1.62-1.55 3.4-1.55 4.95 0 1 .62 1.6 1.55 1.6.6 0 1 .5 1.7.92.66.42 1.45.83 3.02.83s2.36-.41 3.02-.83c.7-.42 1.1-.92 1.7-.92.93 0 1.55-.6 1.55-1.6 0-1.55-.77-3.33-1.55-4.95-.7-1.5-2.1-2.5-2.1-3.55 0-.8.18-1.4.18-2.35 0-2.1-1.25-3.8-3.3-3.8z"/><circle cx="10.4" cy="7.1" r=".95" fill="#faf9f5" stroke="none"/><circle cx="13.6" cy="7.1" r=".95" fill="#faf9f5" stroke="none"/><path d="M11 8.7h2l-1 1.5z" fill="#faf9f5" stroke="none"/></symbol>
