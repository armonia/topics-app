---
/**
 * The home page.
 *
 * Order, and why: one line saying what it is, then the product, then proof that
 * it is alive, then the model you need before the rest means anything. The
 * pitch follows, and the two sections that buy the most trust — the comparison
 * and the declared limits — come BEFORE the price rather than after it.
 *
 * The product sits second because of a measurement. It used to start at 585px,
 * so a 13" laptop showed 215px of it against NN/g's finding that 57% of gaze
 * time is spent above the fold. Pushing it below the model section made that
 * worse, not better: measured at 1440×750 the frame was 1475px down and 0% of
 * it was visible. It is a poster now — a picture until you ask for the app — so
 * putting it high costs nothing, which was the only reason it was ever low.
 */
import Base from '../layouts/Base.astro';
import ChangelogList from '../components/ChangelogList.astro';
import { homeTools, READ_ON } from '../data/compare';
import { repoStats, longDate } from '../lib/repo-stats';

const stats = repoStats();
const fmt = (n: number) => n.toLocaleString('en-GB');

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://topics.armonia.io/#org",
      "name": "Armonia",
      "url": "https://armonia.io",
      "logo": "https://topics.armonia.io/icon.png"
    },
    {
      "@type": "WebSite",
      "@id": "https://topics.armonia.io/#site",
      "url": "https://topics.armonia.io/",
      "name": "Topics",
      "publisher": { "@id": "https://topics.armonia.io/#org" },
      "inLanguage": "en"
    },
    {
      "@type": "SoftwareApplication",
      "name": "Topics",
      "url": "https://topics.armonia.io/",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "macOS, Windows, Linux",
      "softwareVersion": stats.version,
      "license": "https://github.com/armonia/topics-app/blob/main/LICENSE",
      "downloadUrl": "https://github.com/armonia/topics-app/releases/latest",
      "softwareHelp": "https://topics.armonia.io/agents.md",
      "releaseNotes": "https://topics.armonia.io/changelog",
      "isAccessibleForFree": true,
      "publisher": { "@id": "https://topics.armonia.io/#org" },
      "description": "A desktop workspace for CLI coding agents. Several agents work the same repository at once, each task in its own git worktree, and you review and land their work from one window. Free, MIT, runs on your machine, no account and no telemetry.",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
    }
  ]
};
---

<Base
  title="Topics · four agents, one repo, nobody collides"
  description="A desktop workspace for Claude Code, Codex, Gemini CLI and any other terminal agent. Every task gets its own git worktree, so several agents work the same repository at once. A board hands them work and gives it back as a diff. Free, MIT, on your machine."
  ogDescription="Run Claude Code, Codex and Gemini CLI side by side on one repository. Each task in its own worktree, a board that dispatches them, and a diff back. Free and open source."
  path="/"
  jsonLd={jsonLd}
>
