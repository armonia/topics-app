# Cloudflare Workers assets serves every file with
# `public, max-age=0, must-revalidate` by default. Measured on the live site:
# styles.css, app.js, img/*.webp and app/assets/index-*.js all came back with it —
# including the 1.17 MB demo chunk. That means every repeat visit revalidates
# every asset before it may use its own cache, which is the whole cost of a return
# visitor for no benefit, because those paths already carry a content hash or
# change with a deploy.
#
# The HTML is deliberately left alone: it must stay revalidated so a deploy is
# visible immediately.

/app/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

# Astro's own output. Content-hashed in the filename, so a change is a new URL
# and the old one can be cached forever without ever going stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/icon.png
  Cache-Control: public, max-age=604800

# The share card is not hashed and gets regenerated by hand, so a week rather
# than a year — and social scrapers re-fetch on their own schedule anyway.
/og.png
  Cache-Control: public, max-age=604800

/icon-64.png
  Cache-Control: public, max-age=604800

# changelog.json is regenerated by `bun run changelog` and shipped with the site,
# so an hour of staleness is the most it can ever be wrong by.
/changelog.json
  Cache-Control: public, max-age=3600

# Served as text/plain, not text/markdown. Deno serves its agents.md as
# `text/markdown; charset=utf-8` with nosniff, and Firefox and Safari respond by
# downloading the file instead of showing it — which is fine for an agent running
# curl and useless for a person who clicked a link. Anthropic and Vercel both
# serve their llms.txt as text/plain, which renders inline everywhere.
/agents.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # The demo iframe is same-origin today. If the demo ever moves to
  # demo.topics.armonia.io, this becomes the line that breaks it — swap it for a
  # CSP frame-ancestors at the same time as the move, not after.
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
