{
  // ─────────────────────────────────────────────────────────────────────────
  // topics.armonia.io — the marketing site, deployed FROM THIS REPO.
  //
  // Why this file exists: the site used to be served by a Worker created in the
  // Cloudflare dashboard that served `landing/` pinned to a hard-coded commit
  // SHA. Nothing in the repo referenced it and nothing bumped the pin, so the
  // published site silently froze at b1f87064 (2026-06-12) while main moved
  // 1793 commits ahead — the hero still advertised v1.1 during v2.2, and
  // /changelog.html, added in July, returned 404 for anyone who clicked it.
  //
  // A pin nobody owns will always drift. So the deploy now lives next to the
  // thing it deploys: `bun run deploy:landing` uploads whatever is in
  // `landing/` right now, and the version that ships is the version you can
  // read in git.
  //
  // The demo under /app/ is a BUILD ARTIFACT (client → vite.landing.config.ts →
  // landing/public/app/ → copied by astro into landing/dist/app/). "Rebuild it
  // by hand before deploying" was the instruction, and it worked exactly as well
  // as the commit pin did: the bundle sat tracked in git and drifted. `build:site`
  // rebuilds it now, so `deploy:landing` cannot ship a demo older than the client
  // it was built from — and landing/public/app/ is gitignored.
  //
  // The changelog caught the same disease from the same cause. It is generated
  // from git by `bun run changelog` into landing/src/data/changelog.json, and
  // regenerating it was a manual step. On 2026-08-12 the file's newest entry was
  // v2.2.12 while the app was at v2.2.103: 91 versions behind, in the repo, so a
  // deploy made that day would have published a frozen changelog anyway. Two
  // manual steps had now drifted for the same reason, so this one moved too:
  // `build:site` regenerates the changelog before it builds. What ships is what
  // git says, for the demo and for the changelog alike.
  // ─────────────────────────────────────────────────────────────────────────
  "name": "topics-landing",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./landing/dist",
    // `/changelog` → changelog.html, matching the `cleanUrls` the site was
    // written against.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Deploys land on <name>.<subdomain>.workers.dev so a build can be checked
  // before it is the public site. Pointing topics.armonia.io here is a separate,
  // deliberate step (Workers → topics-landing → Domains & Routes), because
  // taking over a live domain should not be a side effect of a deploy.
  "workers_dev": true
}
