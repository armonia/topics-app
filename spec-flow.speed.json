{
  "repo": "armonia/topics-app",
  "workflow": "ci.yml",
  "excludeBranchPrefixes": [
    "esperimento/"
  ],
  "criticalPath": {
    "before": [
      "changes",
      "prepare-e2e"
    ],
    "shards": "^e2e \\([1-9]\\d*\\)$"
  },
  "e2eJobs": "^e2e( \\(\\d+\\))?$",
  "thresholds": {
    "obiettivo": {
      "work": 10,
      "wall": 12,
      "wallP80": 20,
      "jobMinutes": 90,
      "flaky": 2
    },
    "base": {
      "work": 23,
      "wall": 36,
      "wallP80": 66,
      "jobMinutes": 180,
      "flaky": 11
    }
  },
  "flaky": {
    "window": 20,
    "maxRuns": 3,
    "ledger": "test-results/flaky-ledger.json",
    "known": {}
  },
  "proof": {
    "markJob": "changes",
    "inherit": "^chore\\(release\\): bump v",
    "inheritPaths": "^(CHANGELOG\\.md|package\\.json|client/public/changelog\\.json|landing/src/data/changelog\\.json|desktop-tauri/src-tauri/(Cargo\\.toml|Cargo\\.lock|tauri\\.conf\\.json))$",
    "versionOnly": "(^|/)(package\\.json|Cargo\\.toml|Cargo\\.lock|tauri\\.conf\\.json)$"
  },
  "audit": {
    "buildStep": "^Build client",
    "ownRunnerJobs": "^(prepare-e2e|e2e \\(\\d+\\))$",
    "thresholds": {
      "obiettivo": {
        "prWait": 12,
        "prWaitP80": 20,
        "mainWait": 5,
        "doubleShare": 0.1,
        "stalled": 0,
        "builds": 1,
        "hostedShare": 0.3
      },
      "base": {
        "prWait": 30,
        "prWaitP80": 60,
        "mainWait": 30,
        "doubleShare": 1,
        "stalled": 20,
        "builds": 12,
        "hostedShare": 1
      }
    }
  }
}
