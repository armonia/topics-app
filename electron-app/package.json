{
  "name": "topics-app",
  "version": "1.0.0",
  "description": "Topics App - Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "postinstall": "/usr/libexec/PlistBuddy -c \"Set :CFBundleName 'Topics DEV'\" node_modules/electron/dist/Electron.app/Contents/Info.plist 2>/dev/null; /usr/libexec/PlistBuddy -c \"Set :CFBundleDisplayName 'Topics DEV'\" node_modules/electron/dist/Electron.app/Contents/Info.plist 2>/dev/null || true",
    "dev": "electronmon ."
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electronmon": "^2.0.4"
  },
  "build": {
    "appId": "com.topics.app",
    "productName": "Topics",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.icns",
      "target": [
        "dmg",
        "dir"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.icns",
      "tray-icon.png"
    ]
  }
}
