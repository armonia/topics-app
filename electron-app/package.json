{
  "name": "topics-app",
  "version": "1.1.0",
  "description": "Topics App - Electron",
  "author": "Armonia <security@armonia.io>",
  "homepage": "https://github.com/armonia/topics-app",
  "main": "dist/main.js",
  "scripts": {
    "build:ts": "tsc && node -e \"require('fs').readdirSync('.').filter(f=>f.endsWith('.png')||f.endsWith('.html')||f.endsWith('.icns')).forEach(f=>{require('fs').copyFileSync(f,'dist/'+f);require('fs').chmodSync('dist/'+f,0o644)})\"",
    "start": "npm run build:ts && electron dist/main.js",
    "stage:server": "node ../scripts/stage-server-dist.mjs",
    "build": "npm run build:ts && npm run stage:server && electron-builder",
    "dist:mac": "npm run build:ts && npm run stage:server && electron-builder --mac",
    "dist:win": "npm run build:ts && npm run stage:server && electron-builder --win",
    "dist:linux": "npm run build:ts && npm run stage:server && electron-builder --linux",
    "postinstall": "node postinstall.mjs",
    "dev": "npm run build:ts && electronmon dist/main.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "puppeteer-core": "^23.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electronmon": "^2.0.4",
    "typescript": "~5.9.3"
  },
  "build": {
    "appId": "com.topics.app",
    "productName": "Topics",
    "asar": true,
    "asarUnpack": ["**/*.node"],
    "extraResources": [
      { "from": "server-dist", "to": "server", "filter": ["**/*"] }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.icns",
      "identity": null,
      "target": ["dmg", "zip"],
      "x64ArchFiles": "**/server/**",
      "extendInfo": {
        "NSPrefersDisplaySafeAreaCompatibilityMode": false
      }
    },
    "win": {
      "icon": "icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "icon.png",
      "category": "Utility",
      "target": ["AppImage", "deb"]
    },
    "publish": {
      "provider": "github",
      "owner": "armonia",
      "repo": "topics-app",
      "releaseType": "release"
    },
    "files": [
      "dist/main.js", "dist/main.js.map",
      "dist/preload.js", "dist/preload.js.map",
      "dist/overlay.html",
      "dist/overlay-manager.js", "dist/overlay-manager.js.map",
      "dist/overlay-renderer.js", "dist/overlay-renderer.js.map",
      "dist/overlay-preload.js", "dist/overlay-preload.js.map",
      "icon.icns", "icon.png",
      "tray-icon.png",
      "trayTemplate.png", "trayTemplate@2x.png",
      "trayUnreadTemplate.png", "trayUnreadTemplate@2x.png",
      "trayDisconnectedTemplate.png", "trayDisconnectedTemplate@2x.png"
    ]
  }
}
