{
  "compilerOptions": {
    "composite": true,
    /* baseUrl (below) is deprecated as of TS5 and removed in TS7; this silences
       the hard error so `tsc -b` / build:client stays green until we migrate
       off baseUrl (paths already resolve relative to this file in bundler mode).
       Value must match the installed tsc major: "5.0" for tsc 5.x. Using "6.0"
       here errors TS5103 under tsc 5.9.x and silently breaks the typecheck gate. */
    "ignoreDeprecations": "5.0",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "../shared"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "../shared/**/*.test.ts", "../shared/message-blob.ts"]
}