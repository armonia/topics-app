{
  "name": "topics-app",
  "version": "1.0.0",
  "description": "Companion app for OpenClaw — organize AI conversations into focused topics with project context",
  "author": "Armonia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/armonia/topics-app"
  },
  "keywords": [
    "openclaw",
    "ai",
    "topics",
    "chat",
    "companion"
  ],
  "scripts": {
    "start": "bun run server.ts",
    "dev:server": "bun --watch run server.ts",
    "dev:client": "cd client && bun run dev",
    "dev:electron": "DEV_URL=http://localhost:5173 npm --prefix electron-app run dev",
    "prod:electron": "bash scripts/start-electron-prod.sh",
    "build:electron": "cd electron-app && npm run build",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report test-results/html-report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "node-pty": "^1.0.0",
    "playwright-core": "^1.50.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/web-push": "^3.6.4"
  }
}
