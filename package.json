{
  "name": "topics-app",
  "version": "2.2.249",
  "description": "Desktop workspace for coding agents: editor, diff viewer, terminal, browser and a task board, one topic at a time. Agents run inside Topics, not one process each: 200 sessions answering at once fit in 162 MB.",
  "author": "Armonia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/armonia/topics-app"
  },
  "keywords": [
    "claude-code",
    "coding-agent",
    "cli-agents",
    "developer-tools",
    "desktop-app",
    "tauri",
    "terminal",
    "topics"
  ],
  "scripts": {
    "postinstall": "bun run scripts/fix-node-pty-exec-bit.ts",
    "start": "bun run server.ts",
    "dev:server": "bun --watch run server.ts",
    "dev:client": "cd client && bun run dev",
    "build:client": "bun run scripts/build-client.ts",
    "build:client:watch": "cd client && bun run build:watch",
    "build:cli": "bun build cli/topics.ts --compile --outfile dist/topics",
    "bump": "bash scripts/bump-version.sh",
    "changelog": "node scripts/gen-changelog.mjs",
    "og": "bun scripts/og-image.mjs",
    "check:contrast": "node scripts/landing-contrast.mjs",
    "check:field": "node scripts/landing-field.mjs",
    "check:scroll-fluidity": "bun run scripts/check-scroll-fluidity.ts",
    "check:painted": "node scripts/landing-painted.mjs",
    "check:landing": "node scripts/landing-verify.mjs",
    "check:copy": "node scripts/landing-copy.mjs",
    "landing:vividness": "node scripts/landing-vividness.mjs",
    "landing:serve": "cd landing/dist && python3 -m http.server 4321 --bind 127.0.0.1",
    "build:landing": "cd client && bun run build:landing",
    "check:demo": "node scripts/check-demo.mjs",
    "deploy:landing": "bun run build:site && bun run check:demo && bunx wrangler@latest deploy",
    "deploy:landing:dry": "bun run build:site && bun run check:demo && bunx wrangler@latest deploy --dry-run",
    "gen:shortcuts": "bun run scripts/gen-shortcuts.ts",
    "test:cli": "bun test --timeout ${TOPICS_TEST_TIMEOUT_MS:-30000} tests/integration/cli-topics.test.ts",
    "verify:phase30-strip": "bun run build:client && ./scripts/assert-dev-overlay-stripped.sh public",
    "check:any": "bun run scripts/check-any.ts",
    "check:any-budget": "bun run scripts/check-any-budget.ts",
    "check:ref-callbacks": "bun run scripts/check-ref-callbacks.ts",
    "check:nul": "bun run scripts/check-nul-bytes.ts",
    "check:emdash": "bun run scripts/check-emdash.ts",
    "check:sidecars": "bun run scripts/check-tauri-sidecars.ts",
    "sidecars:sync": "bun run scripts/check-tauri-sidecars.ts --fix",
    "check:ui-language": "bun run scripts/check-ui-language.ts",
    "check:comment-language": "bun run scripts/check-comment-language.ts",
    "check:identifier-language": "bun run scripts/check-identifier-language.ts",
    "check:eslint-disable": "bun run scripts/check-eslint-disable.ts",
    "check:test-skips": "bun run scripts/check-test-skips.ts",
    "check:sleeps": "bun run scripts/check-e2e-sleeps.ts",
    "check:e2e-no-verdict": "bun run scripts/check-e2e-no-verdict.ts",
    "check:e2e-touched": "bun run scripts/check-e2e-touched.ts",
    "check:bloat": "bun run scripts/check-bloat.ts",
    "qa:gate": "./scripts/qa-gate.sh",
    "check:security": "bun run scripts/check-security.ts",
    "check:spec-coverage": "bun run scripts/check-spec-coverage.ts",
    "check:untraced-tests": "bun run scripts/check-untraced-tests.ts",
    "obscura:check": "bun run scripts/obscura-track.ts check",
    "obscura:status": "bun run scripts/obscura-track.ts status",
    "obscura:build": "bun run scripts/obscura-track.ts build",
    "check:migrations": "bun run scripts/check-migration-numbers.ts",
    "migration:new": "bun run scripts/new-migration.ts",
    "check:deadcode": "bun run scripts/slot.ts check:deadcode -- './node_modules/.bin/knip-bun'",
    "check:deadcode-blindspots": "bun run scripts/check-deadcode-blindspots.ts",
    "check:previews": "bun run scripts/check-preview-evidence.ts",
    "check:route-latency": "bun run scripts/check-route-latency.ts",
    "probe:stalls": "bun run scripts/stalled-parents.ts",
    "probe:gate-slots": "bun run scripts/probe-gate-concurrency.ts",
    "probe:fdleak": "bun run scripts/fd-leak-probe.ts",
    "check:occlusion": "node scripts/check-occlusion.mjs",
    "check:bundle": "bun run scripts/check-bundle-size.ts",
    "check:ink": "bun run scripts/check-ink-latency.ts",
    "check:drag": "bun run scripts/check-drag-frames.ts",
    "check:growth": "bun run scripts/check-session-growth.ts",
    "probe:boot-memory": "bun run scripts/probe-boot-memory.ts",
    "probe:discord": "bun run scripts/discord-ipc-probe.ts",
    "db:compress": "bun run scripts/compress-message-blobs.ts",
    "check:lockfile": "bun install --frozen-lockfile && cd client && bun install --frozen-lockfile && cd ../landing && bun install --frozen-lockfile",
    "report:disk": "bun run scripts/disk-report.ts",
    "report:webcontent": "bun run scripts/webcontent-owners.ts",
    "report:branches": "bun run scripts/branch-audit.ts",
    "report:landed": "bun run scripts/check-done-landed.ts",
    "measure:task-tabs": "bun run scripts/measure-task-tab-teardown.ts",
    "measure:thread": "bun run scripts/thread-vs-work.ts",
    "measure:ui-state-init": "bun run scripts/measure-ui-state-init.ts",
    "bench": "bun run scripts/bench/run.ts",
    "bench:ai-bridge": "bun run scripts/ai-bridge-replay-bench.ts",
    "orphan:dryrun": "bun run scripts/orphan-park-dryrun.ts",
    "browser:dryrun": "bun run scripts/browser-orphan-dryrun.ts",
    "typecheck": "bun run scripts/slot.ts typecheck -- 'bun run typecheck:client && bun run typecheck:tests:client && bun run typecheck:server && bun run typecheck:e2e && bun run typecheck:relay'",
    "typecheck:client": "cd client && ./node_modules/.bin/tsc -b",
    "typecheck:tests:client": "cd client && ./node_modules/.bin/tsc -p tsconfig.test.json",
    "typecheck:server": "bun run scripts/typecheck-server.ts",
    "typecheck:e2e": "./client/node_modules/.bin/tsc -p tsconfig.e2e.json --ignoreDeprecations 5.0",
    "typecheck:relay": "./client/node_modules/.bin/tsc -p relay/tsconfig.json",
    "test:agents": "TOPICS_REAL_AGENT_TESTS=1 bun test --timeout ${TOPICS_TEST_TIMEOUT_MS:-30000} ./server/providers/acp-jcode-model.integration.test.ts",
    "test:e2e:shards": "./scripts/e2e-shards.sh",
    "test:e2e:plan": "bun run scripts/e2e-plan-shards.ts",
    "test:e2e:durations": "bun run scripts/e2e-record-durations.ts",
    "hooks:install": "bun run scripts/install-claude-hooks.ts install",
    "hooks:uninstall": "bun run scripts/install-claude-hooks.ts uninstall",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:evidence": "E2E_EVIDENCE=1 npx playwright test",
    "test:report": "npx playwright show-report test-results/html-report",
    "test:unit": "bun run scripts/slot.ts test:unit -- 'bun test --timeout ${TOPICS_TEST_TIMEOUT_MS:-30000} ./client/src ./server/ ./shared ./relay ./tests/unit ./tests/integration ./scripts ./cli'",
    "test:unit:junit": "bun run scripts/test-junit.ts",
    "test:heavy": "TOPICS_HEAVY_TESTS=1 bun test --timeout ${TOPICS_TEST_TIMEOUT_MS:-30000} ./server/browser-dom-cobrowse.test.ts ./server/browser-focused-field.test.ts ./server/browser-session-handoff.heavy.test.ts ./server/browser-site-data.heavy.test.ts",
    "evidence:handoff": "bun run scripts/handoff-evidence.ts",
    "lint": "bun run scripts/slot.ts lint -- 'bun run scripts/check-client-deps.ts && (cd client && bun run lint) && ./client/node_modules/.bin/eslint --config client/eslint.config.js relay'",
    "lint:relay": "./client/node_modules/.bin/eslint --config client/eslint.config.js relay",
    "lint:gherkin": "test -d spec-flow || { echo \"lint:gherkin: manca spec-flow/ — è in .gitignore:218, quindi assente da OGNI checkout pulito (clone: armonia/spec-flow). Per questo NON può stare in un workflow.\" >&2; exit 1; }; find tests/features -name '*.feature' -type f 2>/dev/null | grep -q . || { echo \"lint:gherkin: zero .feature sotto tests/features/, non c'è niente da controllare — un verde a vuoto è peggio di nessun cancello (b8092abe). I 5 .feature sono morti con Master (dd1c3f28) e claude-event (9e5516d1); la cartella resta pronta, vedi tests/features/.gitkeep.\" >&2; exit 1; }; bun --bun spec-flow/scripts/lint-gherkin.ts",
    "tag:scenarios": "bun --bun spec-flow/scripts/tag-scenarios.ts",
    "uat": "bun --bun spec-flow/scripts/generate-uat.ts",
    "specflow:link": "test -d spec-flow || { echo \"specflow:link: manca spec-flow/ - e' in .gitignore:218, quindi assente da OGNI checkout pulito (clone: armonia/spec-flow). Per questo NON puo' stare in un workflow.\" >&2; exit 1; }; bun --bun spec-flow/scripts/link-uat.ts",
    "specflow:publish": "test -d spec-flow || { echo \"specflow:publish: manca spec-flow/ - e' in .gitignore:218, quindi assente da OGNI checkout pulito (clone: armonia/spec-flow). Per questo NON puo' stare in un workflow.\" >&2; exit 1; }; bun --bun spec-flow/scripts/publish-uat.ts",
    "specflow:preview": "test -d spec-flow || { echo \"specflow:preview: manca spec-flow/ - e' in .gitignore:218, quindi assente da OGNI checkout pulito (clone: armonia/spec-flow). Per questo NON puo' stare in un workflow.\" >&2; exit 1; }; bun --bun spec-flow/scripts/serve-specs.ts",
    "specflow:evidence": "./scripts/specflow-evidence.sh",
    "build:site": "bun run changelog && cd client && bun install --frozen-lockfile && bun run build:landing && cd ../landing && bun install --frozen-lockfile && bun run build",
    "dev:site": "cd landing && bun run dev",
    "check:history-clean": "bun run scripts/scrub-history.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.0.0",
    "playwright-core": "^1.59.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.14",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.12.1",
    "knip": "6.32.1",
    "ws": "^8.21.3"
  }
}
