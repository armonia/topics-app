{
  "name": "topics-app",
  "version": "2.2.59",
  "description": "Companion app for OpenClaw — organize AI conversations into focused topics with project context",
  "author": "Armonia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/armonia/topics-app"
  },
  "keywords": [
    "openclaw",
    "ai",
    "topics",
    "chat",
    "companion"
  ],
  "scripts": {
    "start": "bun run server.ts",
    "dev:server": "bun --watch run server.ts",
    "dev:client": "cd client && bun run dev",
    "build:client": "cd client && bun run build",
    "build:client:watch": "cd client && bun run build:watch",
    "build:cli": "bun build cli/topics.ts --compile --outfile dist/topics",
    "changelog": "node scripts/gen-changelog.mjs",
    "og": "bun scripts/og-image.mjs",
    "check:contrast": "node scripts/landing-contrast.mjs",
    "check:field": "node scripts/landing-field.mjs",
    "check:painted": "node scripts/landing-painted.mjs",
    "check:landing": "node scripts/landing-verify.mjs",
    "check:copy": "node scripts/landing-copy.mjs",
    "landing:vividness": "node scripts/landing-vividness.mjs",
    "landing:serve": "cd landing/dist && python3 -m http.server 4321 --bind 127.0.0.1",
    "build:landing": "cd client && bun run build:landing",
    "deploy:landing": "bun run build:site && bunx wrangler@latest deploy",
    "deploy:landing:dry": "bun run build:site && bunx wrangler@latest deploy --dry-run",
    "gen:shortcuts": "bun run scripts/gen-shortcuts.ts",
    "test:cli": "bun test tests/integration/cli-topics.test.ts",
    "verify:phase30-strip": "bun run build:client && ./scripts/assert-dev-overlay-stripped.sh public",
    "check:any": "bun run scripts/check-any.ts",
    "check:nul": "bun run scripts/check-nul-bytes.ts",
    "check:eslint-disable": "bun run scripts/check-eslint-disable.ts",
    "check:test-skips": "bun run scripts/check-test-skips.ts",
    "check:deadcode": "bunx --bun knip",
    "check:bundle": "bun run scripts/check-bundle-size.ts",
    "check:ink": "bun run scripts/check-ink-latency.ts",
    "check:lockfile": "bun install --frozen-lockfile && cd client && bun install --frozen-lockfile && cd ../landing && bun install --frozen-lockfile",
    "report:disk": "bun run scripts/disk-report.ts",
    "typecheck": "bun run typecheck:client && bun run typecheck:server && bun run typecheck:e2e",
    "typecheck:client": "cd client && ./node_modules/.bin/tsc -b",
    "typecheck:server": "bun run scripts/typecheck-server.ts",
    "typecheck:e2e": "./client/node_modules/.bin/tsc -p tsconfig.e2e.json --ignoreDeprecations 5.0",
    "test:e2e:shards": "./scripts/e2e-shards.sh",
    "test:e2e:plan": "bun run scripts/e2e-plan-shards.ts",
    "test:e2e:durations": "bun run scripts/e2e-record-durations.ts",
    "hooks:install": "bun run scripts/install-claude-hooks.ts install",
    "hooks:uninstall": "bun run scripts/install-claude-hooks.ts uninstall",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:evidence": "E2E_EVIDENCE=1 npx playwright test",
    "test:report": "npx playwright show-report test-results/html-report",
    "test:unit": "bun test ./client/src ./server/ ./shared ./relay ./tests/unit ./tests/integration ./scripts",
    "test:heavy": "TOPICS_HEAVY_TESTS=1 bun test ./server/browser-dom-cobrowse.test.ts",
    "lint": "cd client && bun run lint",
    "lint:gherkin": "test -d spec-flow || { echo \"lint:gherkin: manca spec-flow/ — è in .gitignore:129, quindi assente da OGNI checkout pulito (clone: armonia/spec-flow). Per questo NON può stare in un workflow.\" >&2; exit 1; }; find tests/features -name '*.feature' -type f 2>/dev/null | grep -q . || { echo \"lint:gherkin: zero .feature sotto tests/features/, non c'è niente da controllare — un verde a vuoto è peggio di nessun cancello (b8092abe). I 5 .feature sono morti con Master (dd1c3f28) e claude-event (9e5516d1); la cartella resta pronta, vedi tests/features/.gitkeep.\" >&2; exit 1; }; bun --bun spec-flow/scripts/lint-gherkin.ts",
    "tag:scenarios": "bun --bun spec-flow/scripts/tag-scenarios.ts",
    "uat": "bun --bun spec-flow/scripts/generate-uat.ts",
    "build:site": "cd landing && bun install --frozen-lockfile && bun run build",
    "dev:site": "cd landing && bun run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.0.0",
    "playwright-core": "^1.59.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.14",
    "@types/web-push": "^3.6.4",
    "axe-core": "^4.12.1"
  }
}
