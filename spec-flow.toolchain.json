{
  "typecheck": {
    "nodeModules": "client/node_modules",
    "runs": [
      {
        "name": "client (tsc -b)",
        "cwd": "client",
        "args": [
          "-b",
          "--force"
        ]
      },
      {
        "name": "client test",
        "cwd": "client",
        "args": [
          "-p",
          "tsconfig.test.json"
        ]
      },
      {
        "name": "server",
        "args": [
          "-p",
          "tsconfig.server.json"
        ]
      },
      {
        "name": "e2e",
        "args": [
          "-p",
          "tsconfig.e2e.json"
        ]
      },
      {
        "name": "relay",
        "args": [
          "-p",
          "relay/tsconfig.json"
        ]
      },
      {
        "name": "e2e noImplicitAny",
        "args": [
          "-p",
          "tsconfig.e2e.json",
          "--noImplicitAny"
        ]
      },
      {
        "name": "client noUncheckedIndexedAccess",
        "cwd": "client",
        "args": [
          "-p",
          "tsconfig.app.json",
          "--noUncheckedIndexedAccess"
        ]
      }
    ]
  }
}
